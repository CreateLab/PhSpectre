<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- Explicit API 36 target (Play requires >= 35). minSdk 29: MediaStore saving needs no storage permission. -->
        <TargetFramework>net10.0-android36.0</TargetFramework>
        <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
        <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
        <Nullable>enable</Nullable>
        <ApplicationId>com.createlab.phspectre</ApplicationId>
        <ApplicationVersion>16</ApplicationVersion>
        <ApplicationDisplayVersion>2.2.1</ApplicationDisplayVersion>
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
        <!-- Local dev machine only — CI runners auto-detect SDK/JDK via ANDROID_HOME/JAVA_HOME,
             and GitHub Actions always sets CI=true, so these are skipped there. -->
        <AndroidSdkDirectory Condition="'$(CI)' != 'true'">C:\Android\sdk</AndroidSdkDirectory>
        <JavaSdkDirectory Condition="'$(CI)' != 'true'">C:\Android\jdk</JavaSdkDirectory>
    </PropertyGroup>

    <!-- Google Play build: dotnet publish -p:PlayStoreBuild=true (see scripts/build-play-aab.ps1).
         Drops the INTERNET permission and the GitHub update check; CI/GitHub APKs keep both. -->
    <PropertyGroup Condition="'$(PlayStoreBuild)' == 'true'">
        <DefineConstants>$(DefineConstants);PLAY_STORE</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Android" Version="12.0.5"/>
        <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.15"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PhSpectre.Avalonia\PhSpectre.Avalonia.csproj"/>
    </ItemGroup>
</Project>
