<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
	<!-- No permissions: files are picked through the system picker, saved through MediaStore,
	     and USB access goes through the runtime UsbManager permission dialog. -->
	<!-- Optional: only used to write recipes into a camera over a USB cable (OTG). -->
	<uses-feature android:name="android.hardware.usb.host" android:required="false" />
	<application android:label="PhSpectre" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="false" />
</manifest>
