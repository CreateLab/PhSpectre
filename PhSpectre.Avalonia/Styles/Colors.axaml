<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        V2 tokens. Both palettes live in ThemeDictionaries so the app theme (System / Light /
        Dark, see App.ApplyAppearance) can change at runtime — every consumer must therefore
        use DynamicResource, a StaticResource would resolve once and never follow the switch.
        AccentBrush is the default accent; App.SetAccent can replace it at runtime.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BackgroundBrush"        Color="#0E0E10"/>   
            <SolidColorBrush x:Key="SurfaceBrush"           Color="#18181B"/>   
            <SolidColorBrush x:Key="CardBorderBrush"        Color="#26262A"/>   
            <SolidColorBrush x:Key="CardBorderPrimaryBrush" Color="#4A4A52"/>   
            <SolidColorBrush x:Key="TextPrimaryBrush"       Color="#F2F2F3"/>
            <SolidColorBrush x:Key="TextSecondaryBrush"     Color="#A0A0A8"/>   
            <SolidColorBrush x:Key="TextMutedBrush"         Color="#7A7A82"/>   
            <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#0E0E10"/>
            <SolidColorBrush x:Key="ErrorBrush"             Color="#FF8C70"/>
            <SolidColorBrush x:Key="HoverOverlayBrush"      Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="PressedOverlayBrush"    Color="#22FFFFFF"/>
            <SolidColorBrush x:Key="DisabledFillBrush"      Color="#28FFFFFF"/>
            <SolidColorBrush x:Key="StageBrush"             Color="#0A0A0B"/>   
            <SolidColorBrush x:Key="PanelBrush"             Color="#141416"/>   
            <SolidColorBrush x:Key="FilmstripBrush"         Color="#101012"/>
            <SolidColorBrush x:Key="FieldBorderBrush"       Color="#34343A"/>
            <SolidColorBrush x:Key="ControlBrush"           Color="#1C1C20"/>   
            <SolidColorBrush x:Key="ControlSelectedBrush"   Color="#2C2C32"/>   
            <SolidColorBrush x:Key="SwitchOffBrush"         Color="#3A3A42"/>
            <SolidColorBrush x:Key="AccentBrush"            Color="#A9C4DC"/>   
            <SolidColorBrush x:Key="AccentInkBrush"         Color="#0E0E10"/>   
            <SolidColorBrush x:Key="AccentSoftBrush"        Color="#1AA9C4DC"/> 
            <SolidColorBrush x:Key="SuccessBrush"           Color="#5BD39B"/>
            <SolidColorBrush x:Key="WarningBrush"           Color="#E8D08A"/>
            <SolidColorBrush x:Key="ScrimBrush"             Color="#99000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BackgroundBrush"        Color="#F6F6F7"/>
            <SolidColorBrush x:Key="SurfaceBrush"           Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBorderBrush"        Color="#DEDEE2"/>
            <SolidColorBrush x:Key="CardBorderPrimaryBrush" Color="#8A8A92"/>
            <SolidColorBrush x:Key="TextPrimaryBrush"       Color="#141416"/>
            <SolidColorBrush x:Key="TextSecondaryBrush"     Color="#55555C"/>
            <SolidColorBrush x:Key="TextMutedBrush"         Color="#8A8A92"/>
            <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#F6F6F7"/>
            <SolidColorBrush x:Key="ErrorBrush"             Color="#C23B1E"/>
            <SolidColorBrush x:Key="HoverOverlayBrush"      Color="#14000000"/>
            <SolidColorBrush x:Key="PressedOverlayBrush"    Color="#22000000"/>
            <SolidColorBrush x:Key="DisabledFillBrush"      Color="#28000000"/>
            <SolidColorBrush x:Key="StageBrush"             Color="#EDEDEF"/>
            <SolidColorBrush x:Key="PanelBrush"             Color="#FFFFFF"/>
            <SolidColorBrush x:Key="FilmstripBrush"         Color="#F0F0F2"/>
            <SolidColorBrush x:Key="FieldBorderBrush"       Color="#C9C9D0"/>
            <SolidColorBrush x:Key="ControlBrush"           Color="#E8E8EC"/>
            <SolidColorBrush x:Key="ControlSelectedBrush"   Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SwitchOffBrush"         Color="#B8B8C0"/>
            <SolidColorBrush x:Key="AccentBrush"            Color="#2F5F8A"/>   
            <SolidColorBrush x:Key="AccentInkBrush"         Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AccentSoftBrush"        Color="#1A2F5F8A"/>
            <SolidColorBrush x:Key="SuccessBrush"           Color="#1E9F6A"/>
            <SolidColorBrush x:Key="WarningBrush"           Color="#9A7B00"/>
            <SolidColorBrush x:Key="ScrimBrush"             Color="#66000000"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
