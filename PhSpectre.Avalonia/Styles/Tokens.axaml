<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Non-colour design tokens (colours live in Colors.axaml, which is theme-aware). These are plain
        values that do not change with the theme, so StaticResource is fine for them. New screens
        (Process, library) use these instead of literals; existing views are migrated opportunistically.
        Full reference: docs/design-system.md.
    -->

    <!-- Spacing: 4-pt scale -->
    <sys:Double x:Key="Space1">4</sys:Double>
    <sys:Double x:Key="Space2">8</sys:Double>
    <sys:Double x:Key="Space3">12</sys:Double>
    <sys:Double x:Key="Space4">16</sys:Double>
    <sys:Double x:Key="Space5">24</sys:Double>
    <sys:Double x:Key="Space6">32</sys:Double>

    <!-- Radius -->
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">10</CornerRadius>
    <CornerRadius x:Key="RadiusXl">16</CornerRadius>

    <!-- Type scale -->
    <sys:Double x:Key="FontCaption">11</sys:Double>
    <sys:Double x:Key="FontSmall">12</sys:Double>
    <sys:Double x:Key="FontBody">13</sys:Double>
    <sys:Double x:Key="FontLabel">14</sys:Double>
    <sys:Double x:Key="FontTitle">18</sys:Double>

    <!-- Touch target: 44 pt minimum on phones / tablets -->
    <sys:Double x:Key="TouchTarget">44</sys:Double>

    <!-- Motion: durations; keep transitions under 250 ms, prefer 120 ms for hover/press -->
    <sys:TimeSpan x:Key="MotionFast">0:0:0.12</sys:TimeSpan>
    <sys:TimeSpan x:Key="MotionBase">0:0:0.2</sys:TimeSpan>

    <!-- Single breakpoint (device-independent px): phone < 840 <= wide (inspector as a column) -->
    <sys:Double x:Key="BreakpointWide">840</sys:Double>
</ResourceDictionary>
