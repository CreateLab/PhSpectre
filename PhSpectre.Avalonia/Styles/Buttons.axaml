<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary action (e.g. Pick a Photo, Save PNG/JPEG): outline button, contrasting border -->
    <Style Selector="Button.primary">
        <Setter Property="Height" Value="44"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <!-- FluentTheme's own base (non-hover) Button style also sets Foreground, at the same
         plain-class specificity, and was winning — hence text only showing up on hover
         (where our :pointerover selector, being pseudo-class-scoped, does outrank it).
         Scoping this to :enabled gives it the same specificity edge. -->
    <Style Selector="Button.primary:enabled">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverOverlayBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderPrimaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.primary:disabled">
        <Setter Property="Background" Value="{StaticResource DisabledFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <!-- Secondary action (e.g. Save to Gallery): thin border, muted text -->
    <Style Selector="Button.secondary">
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="16,0"/>
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#0FFFFFFF"/>
    </Style>

    <!-- Plain text action (e.g. Done on the settings header): no border, full-weight text -->
    <Style Selector="Button.text">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinWidth" Value="88"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.text:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.text:pointerover">
        <Setter Property="Opacity" Value="0.7"/>
    </Style>

    <!-- Danger/cancel action (e.g. Cancel during batch export): reuses the same outline
         shape as .secondary but in the error color, so its meaning reads as "stop", not
         just another muted secondary button. -->
    <Style Selector="Button.danger-outline">
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Button.danger-outline:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverOverlayBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
    </Style>
    <Style Selector="Button.danger-outline:disabled">
        <Setter Property="Background" Value="{StaticResource DisabledFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <!-- Small square icon-only button used in toolbars (settings, reopen-photo) -->
    <Style Selector="Button.icon-toolbar">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.icon-toolbar:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#14FFFFFF"/>
    </Style>

    <!-- Small icon button overlaid directly on a photo thumbnail (collage tray's
         remove/reorder buttons) — needs its own opaque-ish backing so it stays legible
         against whatever's underneath, and square-ish (small radius) corners rather than
         icon-toolbar's near-circular look at this size. -->
    <Style Selector="Button.tray-overlay">
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="#99000000"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.tray-overlay:pointerover">
        <Setter Property="Background" Value="#CC000000"/>
    </Style>

</Styles>
