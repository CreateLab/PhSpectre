<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PhSpectre.Avalonia.Views"
             xmlns:vm="using:PhSpectre.Avalonia.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PhSpectre.Avalonia.Views.EditCanvas"
             x:DataType="vm:ProcessViewModel">

    <!-- Edit canvas (DataContext = Settings.Process): the neutral stage with the graded photo. -->
    <Grid Background="{DynamicResource StageBrush}">
        <Image x:Name="Photo" Source="{Binding Shown}" Stretch="Uniform" Margin="{Binding StageMargin}" IsVisible="{Binding ShowPhotoView}"/>

        <!-- Crop: the whole photo, moved / rotated / scaled by transforms under a clipped window (no re-render per drag) -->
        <Grid x:Name="CropHost" Margin="{Binding StageMargin}" Background="Transparent" IsVisible="{Binding ShowCropView}">
            <Border x:Name="CropWindow" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas x:Name="CropCanvas">
                    <Image x:Name="CropImage" Source="{Binding CropBase}" Stretch="Fill" RenderTransformOrigin="50%,50%"
                           RenderOptions.BitmapInterpolationMode="MediumQuality"/>
                </Canvas>
            </Border>
        </Grid>

        <Button IsVisible="{Binding ShowEmpty}" Command="{Binding OpenPhotosCommand}" Background="Transparent"
                BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,28"
                Cursor="Hand" AutomationProperties.Name="Open photos">
            <StackPanel Spacing="10">
                <materialIcons:MaterialIcon Kind="ImageOutline" Width="40" Height="40" HorizontalAlignment="Center"
                                            Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="Open a photo to start" HorizontalAlignment="Center" FontSize="15"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Tap here, or use + in the strip below." HorizontalAlignment="Center" Classes="hint"/>
            </StackPanel>
        </Button>
        <StackPanel IsVisible="{Binding HasError}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
            <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="36" Height="36" HorizontalAlignment="Center"
                                        Foreground="{DynamicResource ErrorBrush}"/>
            <TextBlock Text="{Binding ErrorText}" HorizontalAlignment="Center" Foreground="{DynamicResource ErrorBrush}"/>
            <TextBlock Text="{Binding PhotoName}" HorizontalAlignment="Center" Classes="hint"/>
        </StackPanel>

        <!-- Canvas toolbar -->
        <Border Classes="pill" IsVisible="{Binding ShowCompare}" Padding="10,6"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18">
            <local:CompareSwitch SelectedIndex="{Binding CompareIndex}"
                     ToolTip.Tip="Compare with the original (hold \)" AutomationProperties.Name="Result or original"/>
        </Border>

        <Border IsVisible="{Binding HasPhoto}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,0,0" MaxWidth="220"
                Background="{DynamicResource ScrimBrush}" CornerRadius="6" Padding="8,3">
            <TextBlock Text="{Binding PhotoName}" FontSize="12" Foreground="White" TextTrimming="CharacterEllipsis"/>
        </Border>

        <Border IsVisible="{Binding IsRendering}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0"
                Background="{DynamicResource ScrimBrush}" CornerRadius="6" Padding="8,3">
            <TextBlock Text="Updating…" FontSize="12" Foreground="White"/>
        </Border>

        <!-- Why the frame type changed on its own -->
        <Border IsVisible="{Binding Settings.HasFrameNotice}" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="16" Padding="14,10" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding Settings.FrameNotice}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button Classes="link" Content="Undo" IsVisible="{Binding Settings.CanUndoFrameSwitch}"
                        Command="{Binding Settings.UndoFrameSwitchCommand}"/>
                <local:IconButton Width="28" Height="28" AutomationProperties.Name="Dismiss"
                        Command="{Binding Settings.DismissFrameNoticeCommand}" Icon="Close" IconSize="14"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
