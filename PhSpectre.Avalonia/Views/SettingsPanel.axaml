<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:PhSpectre.Avalonia.ViewModels"
             xmlns:local="using:PhSpectre.Avalonia.Views"
             x:Class="PhSpectre.Avalonia.Views.SettingsPanel"
             x:DataType="vm:SettingsViewModel">

    <!--
        Inspector (HANDOFF §2.3): three tabs — Style / Content / Export — shared by the desktop
        sidebar and the mobile sheet. Rows follow the V2 kit in Styles/Controls.axaml. Every
        setting is either usable or states why it isn't (hint line under it).
    -->
    <UserControl.Styles>
        <Style Selector="Grid.row">
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        <Style Selector="Grid.row ComboBox">
            <Setter Property="Width" Value="170"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="StackPanel.group">
            <Setter Property="Spacing" Value="4"/>
        </Style>
        <Style Selector="Border.recipe-plate">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style Selector="TextBlock.recipe-plate-label">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.recipe-plate-value">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Edit header: Look · Frame, then the frame type (Card / Recipe card stay in this layout) -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,12,8" IsVisible="{Binding IsEditMode}">
            <ListBox Classes="seg" SelectedIndex="{Binding CardTopIndex}">
                <ListBoxItem Content="Look"/>
                <ListBoxItem Content="Frame"/>
                <ListBoxItem Content="Export" IsVisible="{Binding IsEditMode}"/>
            </ListBox>
            <ListBox Classes="seg" x:Name="FrameLayoutBox" SelectedIndex="{Binding FrameTypeIndex}" IsVisible="{Binding CardShowsOptions}">
                <ListBoxItem Content="None"/>
                <ListBoxItem Content="Border"/>
                <ListBoxItem Content="Card"/>
                <ListBoxItem Content="Recipe" IsEnabled="{Binding RecipeCardAvailable}"/>
                <ListBoxItem Content="Film"/>
            </ListBox>
            <TextBlock Text="{Binding RecipeCardReason}" Classes="hint" TextWrapping="Wrap"
                       IsVisible="{Binding ShowRecipeCardReasonInFrame}"/>
            <TextBlock Text="{Binding FrameNotice}" Foreground="{DynamicResource WarningBrush}" FontSize="12"
                       TextWrapping="Wrap" IsVisible="{Binding HasFrameNotice}"/>
        </StackPanel>
        <!-- Tabs -->
        <ListBox Grid.Row="1" Classes="seg" x:Name="TabsBox" IsVisible="{Binding CardTabsVisible}" Margin="0,0,0,4"
                 SelectedIndex="{Binding ActiveTabIndex}">
            <ListBoxItem Content="Style"/>
            <ListBoxItem Content="Content"/>
            <ListBoxItem Content="Export" IsVisible="{Binding !IsEditMode}"/>
        </ListBox>

        <ScrollViewer Grid.Row="2" IsVisible="{Binding !IsRecipeEditorOpen}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
        <Panel>

        <!-- ═════════════════════════ STYLE ═════════════════════════ -->
        <local:CardStyleSection IsVisible="{Binding IsStyleTab}"/>

        <!-- ═════════════════════════ CONTENT ═════════════════════════ -->
        <local:CardContentSection IsVisible="{Binding IsContentTab}"/>

        <!-- ═════════════════════════ EXPORT ═════════════════════════ -->
        <StackPanel IsVisible="{Binding IsExportTab}" Margin="0,0,0,28">
            <local:CardExportSection/>
            <!-- ABOUT -->
            <TextBlock Text="ABOUT" Classes="section-title"/>
            <TextBlock Text="{Binding AppVersionText}" Classes="hint"/>
            <Button Classes="link" IsVisible="{Binding ShowUpdateRow}" HorizontalAlignment="Left" Margin="0,6,0,0"
                    Content="{Binding UpdateAvailableText}" Command="{Binding OpenUpdateUrlCommand}"/>
            <Border Background="White" CornerRadius="8" Padding="10" HorizontalAlignment="Left" Margin="0,12,0,0">
                <Image Source="/Assets/qr-code.png" Width="140" Height="140" RenderOptions.BitmapInterpolationMode="None"/>
            </Border>
        </StackPanel>


        <!-- ═════════════════════════ CAMERA ═════════════════════════ -->
        </Panel>
        </ScrollViewer>

        <!-- Recipe editor: replaces the whole inspector while open (header / scrolling body / sticky footer) -->
        <local:RecipeEditorView Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsRecipeEditorOpen}"/>
    </Grid>

</UserControl>
