<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhSpectre.Avalonia.ViewModels"
             x:Class="PhSpectre.Avalonia.Views.SettingsPanel"
             x:DataType="vm:SettingsViewModel">

    <!--
        Plain text group headers, not Expander/collapsible cards — 12 settings across 4
        groups doesn't need collapsing, and Expander's FluentTheme chrome was the source of
        the accent-colored-header bug in the previous iteration. A thin Border under
        Classes="section-sep" stands in for a divider (not the FluentTheme Separator
        control, to keep its exact appearance under our own control).
    -->
    <UserControl.Styles>
        <Style Selector="TextBlock.section-header">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="LetterSpacing" Value="0.8"/>
            <Setter Property="Margin" Value="0,20,0,8"/>
        </Style>
        <Style Selector="TextBlock.section-header.first">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Border.section-sep">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style Selector="TextBlock.row-label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,12,4"/>
        </Style>
        <Style Selector="Grid.settings-row">
            <Setter Property="MinHeight" Value="44"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="ItemTemplate">
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </DataTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox, RadioButton">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style Selector="Border.recipe-plate">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="MinWidth" Value="96"/>
            <!-- Capped so a long value wraps inside the plate instead of stretching the
                 WrapPanel's column arbitrarily wide (bugfix-pass §2). -->
            <Setter Property="MaxWidth" Value="160"/>
        </Style>
        <Style Selector="TextBlock.recipe-plate-label">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.recipe-plate-value">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="0" Grid.IsSharedSizeScope="True">

        <!-- ── Export mode ───────────────────────────────────────── -->
        <StackPanel IsVisible="{Binding ShowExportModeSectionUI}">
        <TextBlock Text="EXPORT MODE" Classes="section-header first"/>
        <ComboBox x:Name="ExportModeBox" HorizontalAlignment="Stretch"/>
        </StackPanel>

        <!-- ── Palette ───────────────────────────────────────────── -->
        <StackPanel IsVisible="{Binding ShowPaletteSectionUI}">
        <Border Classes="section-sep"/>
        <TextBlock Text="PALETTE" Classes="section-header"/>
        <StackPanel Spacing="10">

            <Grid x:Name="SamplingRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Sampling" Classes="row-label"/>
                <ComboBox Grid.Column="1" x:Name="SamplingModeBox"
                          SelectedIndex="{Binding SamplingModeIndex}"/>
            </Grid>

            <Grid x:Name="ColorCountRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Colors" Classes="row-label"/>
                <ComboBox Grid.Column="1" x:Name="ColorCountBox"
                          SelectedIndex="{Binding ColorCountIndex}"/>
            </Grid>

            <Grid x:Name="ExportThemeRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Controls the exported image's background/text theme, not the app's own
                     UI (that's fixed — dark on Android, always-light on Desktop). Labeled
                     "Export theme" (not "Theme") so it doesn't read as a dead app-theme toggle. -->
                <TextBlock Grid.Column="0" Text="Export theme" Classes="row-label"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <RadioButton Content="Dark"  IsChecked="{Binding IsDarkTheme}"/>
                    <RadioButton Content="Light" IsChecked="{Binding IsDarkTheme,
                                                  Converter={x:Static BoolConverters.Not}}"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="GuideRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Guide lines" Classes="row-label"/>
                <ComboBox Grid.Column="1" x:Name="CompositionGuideBox"
                          SelectedIndex="{Binding CompositionGuideIndex}"/>
            </Grid>

        </StackPanel>
        </StackPanel>

        <!-- ── Collage (only while the Main VM has switched into collage mode) ─── -->
        <StackPanel IsVisible="{Binding ShowCollageSectionUI}">
            <Border Classes="section-sep"/>
            <TextBlock Text="COLLAGE" Classes="section-header"/>
            <StackPanel Spacing="10">

                <Grid x:Name="GutterThicknessRow" Classes="settings-row">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Gutter width" Classes="row-label"/>
                    <Slider Grid.Column="1" Value="{Binding GutterThickness}"
                            Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock Grid.Column="2" Text="{Binding GutterThickness, StringFormat={}{0}px}"
                               Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="34"/>
                </Grid>

            </StackPanel>
        </StackPanel>

        <!-- ── Swatches ──────────────────────────────────────────── -->
        <StackPanel IsVisible="{Binding ShowSwatchesSectionUI}">
        <Border Classes="section-sep"/>
        <TextBlock Text="SWATCHES" Classes="section-header"/>
        <StackPanel Spacing="10">
            <CheckBox IsChecked="{Binding ShowHex}">
                <TextBlock Text="Show hex labels on swatches" TextWrapping="Wrap"/>
            </CheckBox>
            <CheckBox IsChecked="{Binding HexBelow}" IsEnabled="{Binding ShowHex}"
                      ToolTip.Tip="Off puts labels above the swatch instead of below">
                <TextBlock Text="Labels below swatches" TextWrapping="Wrap"/>
            </CheckBox>
            <CheckBox IsChecked="{Binding ShowPercent}">
                <TextBlock Text="Show percentage on swatches" TextWrapping="Wrap"/>
            </CheckBox>

            <Grid x:Name="ShapeRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Shape" Classes="row-label"/>
                <ComboBox Grid.Column="1" x:Name="SwatchShapeBox"
                          SelectedIndex="{Binding SwatchShapeIndex}"/>
            </Grid>

            <Grid x:Name="SortRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Sort" Classes="row-label"/>
                <ComboBox Grid.Column="1" x:Name="SortOrderBox"
                          SelectedIndex="{Binding SortOrderIndex}"/>
            </Grid>

            <Grid x:Name="SwatchScaleRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Plate size" Classes="row-label"/>
                <Slider Grid.Column="1" Value="{Binding SwatchScaleIndex}"
                        Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"
                        TickPlacement="BottomRight"/>
                <TextBlock Grid.Column="2" Text="{Binding SwatchScaleLabel}"
                           Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="34"/>
            </Grid>

            <Grid x:Name="LabelScaleRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Label size" Classes="row-label"/>
                <Slider Grid.Column="1" Value="{Binding LabelScaleIndex}"
                        Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"
                        TickPlacement="BottomRight"/>
                <TextBlock Grid.Column="2" Text="{Binding LabelScaleLabel}"
                           Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="34"/>
            </Grid>

            <CheckBox IsChecked="{Binding UseCustomBackground}">
                <TextBlock Text="Custom background color" TextWrapping="Wrap"/>
            </CheckBox>
            <TextBox Text="{Binding CustomBackgroundHex}" IsEnabled="{Binding UseCustomBackground}"
                      PlaceholderText="#RRGGBB"/>
        </StackPanel>
        </StackPanel>

        <!-- ── Metadata (render verbosity/style) — only relevant when the camera-info
             plate is actually going to be drawn -->
        <StackPanel IsVisible="{Binding ShowMetaVerbositySectionUI}">
        <Border Classes="section-sep"/>
        <TextBlock Text="METADATA" Classes="section-header"/>
        <StackPanel Spacing="10">

            <Grid x:Name="VerbosityRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Verbosity" Classes="row-label"/>
                <ComboBox Grid.Column="1" x:Name="MetaVerbosityBox"
                          SelectedIndex="{Binding MetaVerbosityIndex}"/>
            </Grid>

            <Grid x:Name="StyleRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Style" Classes="row-label"/>
                <ComboBox Grid.Column="1" x:Name="MetaStyleBox"
                          SelectedIndex="{Binding MetaStyleIndex}"/>
            </Grid>

        </StackPanel>
        </StackPanel>

        <!-- ── Output ────────────────────────────────────────────── -->
        <StackPanel IsVisible="{Binding ShowOutputSectionUI}">
        <Border Classes="section-sep"/>
        <TextBlock Text="OUTPUT" Classes="section-header"/>
        <StackPanel Spacing="10">

            <CheckBox IsChecked="{Binding ShowCameraInfo}" IsEnabled="{Binding IsCameraInfoToggleEnabled}"
                      ToolTip.Tip="Info only / Collage (fast) always show this — nothing else to toggle there">
                <TextBlock Text="Show camera info plate" TextWrapping="Wrap"/>
            </CheckBox>

            <Grid x:Name="FormatRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Format" Classes="row-label"/>
                <ComboBox Grid.Column="1" x:Name="OutputFormatBox"
                          SelectedIndex="{Binding OutputFormatIndex}"/>
            </Grid>

            <Grid x:Name="ExportSizeRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Export size" Classes="row-label"/>
                <ComboBox Grid.Column="1" x:Name="ExportPresetBox"
                          SelectedIndex="{Binding ExportSizeIndex}"/>
            </Grid>

            <Grid x:Name="WorkingQualityRow" Classes="settings-row" IsVisible="{Binding IsMobile}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Working size" Classes="row-label"/>
                <ComboBox Grid.Column="1" x:Name="WorkingQualityBox"
                          SelectedIndex="{Binding WorkingQualityIndex}"/>
            </Grid>

        </StackPanel>
        </StackPanel>

        <!-- ── Photo metadata ────────────────────────────────────── -->
        <!-- Only relevant in Recipe mode, or whenever the camera-info plate is actually
             going to be drawn (any mode with the info toggle on) — see §5. -->
        <StackPanel IsVisible="{Binding ShowPhotoMetadataSectionUI}">
        <Border Classes="section-sep"/>
        <Grid ColumnDefinitions="*,50">
            <TextBlock Grid.Column="0" Text="PHOTO METADATA" Classes="section-header"/>
            <Border Grid.Column="1" Background="Transparent" Cursor="Hand"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,20,0,8"
                    Tapped="ToggleMetadataEditor_Tapped">
                <TextBlock Text="{Binding MetadataEditorToggleLabel}" FontSize="11"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </Border>
        </Grid>
        <!-- Only Camera/Lens/Focal/Aperture/Shutter/ISO/Date are editable — the strip's other
             fields (35mm-eq, exposure bias, white balance, exposure program, serial) always
             come straight from the photo's real EXIF. -->
        <StackPanel Spacing="10" IsVisible="{Binding IsMetadataEditorExpanded}">

            <Grid x:Name="MetaCameraRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Camera" Classes="row-label"/>
                <TextBox Grid.Column="1" Text="{Binding MetaCameraText}" PlaceholderText="e.g. Canon EOS R5"/>
            </Grid>

            <Grid x:Name="MetaLensRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Lens" Classes="row-label"/>
                <TextBox Grid.Column="1" Text="{Binding MetaLensText}" PlaceholderText="e.g. RF 24-70mm f/2.8"/>
            </Grid>

            <Grid x:Name="MetaFocalRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Focal (mm)" Classes="row-label"/>
                <NumericUpDown Grid.Column="1" Value="{Binding FocalMm}" Minimum="0" Maximum="2000" Increment="1"
                                FormatString="0.#" ParsingNumberStyle="Float"/>
            </Grid>

            <Grid x:Name="MetaApertureRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Aperture" Classes="row-label"/>
                <TextBox Grid.Column="1" Text="{Binding MetaApertureText, UpdateSourceTrigger=LostFocus}"
                         PlaceholderText="e.g. f/2.8" ToolTip.Tip="Format: f/X.X — invalid values are discarded on commit"/>
            </Grid>

            <Grid x:Name="MetaShutterRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Shutter" Classes="row-label"/>
                <TextBox Grid.Column="1" Text="{Binding MetaShutterText, UpdateSourceTrigger=LostFocus}"
                         PlaceholderText="e.g. 1/200s" ToolTip.Tip="Format: 1/Xs or Xs — invalid values are discarded on commit"/>
            </Grid>

            <Grid x:Name="MetaIsoRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="ISO" Classes="row-label"/>
                <NumericUpDown Grid.Column="1" Value="{Binding IsoValue}" Minimum="0" Maximum="512000" Increment="100"
                                FormatString="0" ParsingNumberStyle="Float"/>
            </Grid>

            <Grid x:Name="MetaDateRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Date" Classes="row-label"/>
                <TextBox Grid.Column="1" Text="{Binding MetaDateText}" PlaceholderText="e.g. 2026-07-05"/>
            </Grid>

            <Button Classes="secondary" HorizontalAlignment="Left"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Content="Reset to photo's EXIF"
                    Command="{Binding ResetMetadataCommand}"/>

        </StackPanel>
        </StackPanel>

        <!-- ── Film recipe (Fujifilm auto-detect, or manual entry for any photo) ──
             Auto-detected fields are read-only; manual entry (Set recipe manually / Edit)
             replaces the whole recipe and switches the badge to "Custom". Always visible
             within Recipe mode (unlike Photo metadata above, no Edit/Hide toggle) since
             there's nothing to expand — just the "no data" state, the card, or the editor
             form. Only relevant in Recipe mode — see §5. -->
        <StackPanel IsVisible="{Binding ShowFilmRecipeSectionUI}">
        <Border Classes="section-sep"/>
        <TextBlock Text="FILM RECIPE" Classes="section-header"/>

        <StackPanel Spacing="10" IsVisible="{Binding !HasRecipe}">
            <TextBlock Text="Film recipe detection currently works for Fujifilm cameras only."
                       Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
            <Button Classes="secondary" Content="Set recipe manually" HorizontalAlignment="Left"
                    Command="{Binding OpenRecipeEditorCommand}"/>
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding HasRecipe}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding RecipeTitleText}" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RecipeSourceBadgeText}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>
                <Button Grid.Column="2" Classes="text" Content="Edit" MinWidth="0" Margin="8,0,0,0"
                        Command="{Binding OpenRecipeEditorCommand}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding RecipeParameterRows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecipeParameterRow">
                        <Border Classes="recipe-plate">
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Label}" Classes="recipe-plate-label" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Value}" Classes="recipe-plate-value" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Manual recipe editor form — opened via "Set recipe manually" / "Edit" above. -->
        <StackPanel Spacing="8" IsVisible="{Binding IsRecipeEditorOpen}" Margin="0,10,0,0">
            <Border Classes="section-sep"/>
            <TextBlock Text="Recipe name" Classes="row-label"/>
            <TextBox Text="{Binding EditRecipeName}" PlaceholderText="e.g. Kodak Portra 400"/>

            <Grid Classes="settings-row" ColumnDefinitions="*,*">
                <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="2">
                    <TextBlock Text="White balance" Classes="row-label"/>
                    <ComboBox ItemsSource="{Binding WhiteBalanceOptions}" SelectedItem="{Binding EditWhiteBalance}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="2">
                    <TextBlock Text="Dynamic range" Classes="row-label"/>
                    <ComboBox ItemsSource="{Binding DynamicRangeOptions}" SelectedItem="{Binding EditDynamicRange}"/>
                </StackPanel>
            </Grid>

            <Grid Classes="settings-row" ColumnDefinitions="*,*">
                <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="2">
                    <TextBlock Text="WB shift (Red)" Classes="row-label"/>
                    <NumericUpDown Value="{Binding EditWhiteBalanceShiftRed}" Minimum="-9" Maximum="9" Increment="1"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="2">
                    <TextBlock Text="WB shift (Blue)" Classes="row-label"/>
                    <NumericUpDown Value="{Binding EditWhiteBalanceShiftBlue}" Minimum="-9" Maximum="9" Increment="1"/>
                </StackPanel>
            </Grid>

            <Grid Classes="settings-row" ColumnDefinitions="*,*">
                <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="2">
                    <TextBlock Text="Highlight tone" Classes="row-label"/>
                    <NumericUpDown Value="{Binding EditHighlightTone}" Minimum="-2" Maximum="4" Increment="1"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="2">
                    <TextBlock Text="Shadow tone" Classes="row-label"/>
                    <NumericUpDown Value="{Binding EditShadowTone}" Minimum="-2" Maximum="4" Increment="1"/>
                </StackPanel>
            </Grid>

            <Grid Classes="settings-row" ColumnDefinitions="*,*">
                <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="2">
                    <TextBlock Text="Color" Classes="row-label"/>
                    <NumericUpDown Value="{Binding EditColor}" Minimum="-4" Maximum="4" Increment="1"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="2">
                    <TextBlock Text="Sharpness" Classes="row-label"/>
                    <NumericUpDown Value="{Binding EditSharpness}" Minimum="-4" Maximum="4" Increment="1"/>
                </StackPanel>
            </Grid>

            <Grid Classes="settings-row" ColumnDefinitions="*,*">
                <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="2">
                    <TextBlock Text="Noise reduction" Classes="row-label"/>
                    <NumericUpDown Value="{Binding EditNoiseReduction}" Minimum="-4" Maximum="4" Increment="1"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="2">
                    <TextBlock Text="Clarity" Classes="row-label"/>
                    <NumericUpDown Value="{Binding EditClarity}" Minimum="-5" Maximum="5" Increment="0.5"/>
                </StackPanel>
            </Grid>

            <Grid Classes="settings-row" ColumnDefinitions="*,*">
                <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="2">
                    <TextBlock Text="Grain effect" Classes="row-label"/>
                    <ComboBox ItemsSource="{Binding ThreeLevelOptions}" SelectedItem="{Binding EditGrainEffect}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="2">
                    <TextBlock Text="B&amp;W adjustment" Classes="row-label"/>
                    <NumericUpDown Value="{Binding EditBwAdjustment}" Minimum="-9" Maximum="9" Increment="1"/>
                </StackPanel>
            </Grid>

            <Grid Classes="settings-row" ColumnDefinitions="*,*">
                <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="2">
                    <TextBlock Text="Color Chrome" Classes="row-label"/>
                    <ComboBox ItemsSource="{Binding ThreeLevelOptions}" SelectedItem="{Binding EditColorChromeEffect}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="2">
                    <TextBlock Text="Color Chrome Blue" Classes="row-label"/>
                    <ComboBox ItemsSource="{Binding ThreeLevelOptions}" SelectedItem="{Binding EditColorChromeFxBlue}"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Button Classes="primary" Content="Save" Command="{Binding SaveRecipeEditsCommand}"/>
                <Button Classes="secondary" Content="Cancel" Command="{Binding CancelRecipeEditorCommand}"/>
            </StackPanel>
        </StackPanel>
        </StackPanel>

        <!-- ── About ─────────────────────────────────────────────── -->
        <StackPanel IsVisible="{Binding ShowAboutSectionUI}">
        <Border Classes="section-sep"/>
        <TextBlock Text="ABOUT" Classes="section-header"/>
        <StackPanel Spacing="10">
            <TextBlock Text="{Binding AppVersionText}" Opacity="0.6" FontSize="12"/>
            <!-- Desktop gets a dismissible toolbar banner instead (MainWindow.axaml) —
                 this row only matters where there's no toolbar to put that in. -->
            <Button Classes="text" IsVisible="{Binding ShowUpdateRow}" MinWidth="0" MinHeight="0" Padding="0"
                    HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                    Content="{Binding UpdateAvailableText}"
                    Command="{Binding OpenUpdateUrlCommand}"/>
        </StackPanel>
        </StackPanel>

    </StackPanel>

</UserControl>
