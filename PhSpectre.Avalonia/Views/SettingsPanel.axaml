<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhSpectre.Avalonia.ViewModels"
             x:Class="PhSpectre.Avalonia.Views.SettingsPanel"
             x:DataType="vm:SettingsViewModel">

    <!--
        Plain text group headers, not Expander/collapsible cards — 12 settings across 4
        groups doesn't need collapsing, and Expander's FluentTheme chrome was the source of
        the accent-colored-header bug in the previous iteration. A thin Border under
        Classes="section-sep" stands in for a divider (not the FluentTheme Separator
        control, to keep its exact appearance under our own control).
    -->
    <UserControl.Styles>
        <Style Selector="TextBlock.section-header">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="LetterSpacing" Value="0.8"/>
            <Setter Property="Margin" Value="0,20,0,8"/>
        </Style>
        <Style Selector="TextBlock.section-header.first">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Border.section-sep">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style Selector="TextBlock.row-label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,12,4"/>
        </Style>
        <Style Selector="Grid.settings-row">
            <Setter Property="MinHeight" Value="44"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="ItemTemplate">
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </DataTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox, RadioButton">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="0" Grid.IsSharedSizeScope="True">

        <!-- ── Palette ───────────────────────────────────────────── -->
        <TextBlock Text="PALETTE" Classes="section-header first"/>
        <StackPanel Spacing="10">

            <Grid x:Name="SamplingRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Sampling" Classes="row-label"/>
                <ComboBox Grid.Column="1" x:Name="SamplingModeBox"
                          SelectedIndex="{Binding SamplingModeIndex}"/>
            </Grid>

            <Grid x:Name="ColorCountRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Colors" Classes="row-label"/>
                <ComboBox Grid.Column="1" x:Name="ColorCountBox"
                          SelectedIndex="{Binding ColorCountIndex}"/>
            </Grid>

            <Grid x:Name="ExportThemeRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Controls the exported image's background/text theme, not the app's own
                     UI (that's fixed — dark on Android, always-light on Desktop). Labeled
                     "Export theme" (not "Theme") so it doesn't read as a dead app-theme toggle. -->
                <TextBlock Grid.Column="0" Text="Export theme" Classes="row-label"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <RadioButton Content="Dark"  IsChecked="{Binding IsDarkTheme}"/>
                    <RadioButton Content="Light" IsChecked="{Binding IsDarkTheme,
                                                  Converter={x:Static BoolConverters.Not}}"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="GuideRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Guide lines" Classes="row-label"/>
                <ComboBox Grid.Column="1" x:Name="CompositionGuideBox"
                          SelectedIndex="{Binding CompositionGuideIndex}"/>
            </Grid>

        </StackPanel>

        <!-- ── Collage (only while the Main VM has switched into collage mode) ─── -->
        <StackPanel IsVisible="{Binding ShowCollageOptions}">
            <Border Classes="section-sep"/>
            <TextBlock Text="COLLAGE" Classes="section-header"/>
            <StackPanel Spacing="10">

                <Grid x:Name="GutterThicknessRow" Classes="settings-row">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Gutter width" Classes="row-label"/>
                    <Slider Grid.Column="1" Value="{Binding GutterThickness}"
                            Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock Grid.Column="2" Text="{Binding GutterThickness, StringFormat={}{0}px}"
                               Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="34"/>
                </Grid>

            </StackPanel>
        </StackPanel>

        <!-- ── Swatches ──────────────────────────────────────────── -->
        <Border Classes="section-sep"/>
        <TextBlock Text="SWATCHES" Classes="section-header"/>
        <StackPanel Spacing="10">
            <CheckBox IsChecked="{Binding ShowHex}">
                <TextBlock Text="Show hex labels on swatches" TextWrapping="Wrap"/>
            </CheckBox>
            <CheckBox IsChecked="{Binding HexBelow}" IsEnabled="{Binding ShowHex}"
                      ToolTip.Tip="Off puts labels above the swatch instead of below">
                <TextBlock Text="Labels below swatches" TextWrapping="Wrap"/>
            </CheckBox>
            <CheckBox IsChecked="{Binding ShowPercent}">
                <TextBlock Text="Show percentage on swatches" TextWrapping="Wrap"/>
            </CheckBox>

            <Grid x:Name="ShapeRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Shape" Classes="row-label"/>
                <ComboBox Grid.Column="1" x:Name="SwatchShapeBox"
                          SelectedIndex="{Binding SwatchShapeIndex}"/>
            </Grid>

            <Grid x:Name="SortRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Sort" Classes="row-label"/>
                <ComboBox Grid.Column="1" x:Name="SortOrderBox"
                          SelectedIndex="{Binding SortOrderIndex}"/>
            </Grid>

            <Grid x:Name="SwatchScaleRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Plate size" Classes="row-label"/>
                <Slider Grid.Column="1" Value="{Binding SwatchScale}"
                        Minimum="0.5" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                <TextBlock Grid.Column="2" Text="{Binding SwatchScale, StringFormat={}{0:0.0}x}"
                           Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="34"/>
            </Grid>

            <Grid x:Name="LabelScaleRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Label size" Classes="row-label"/>
                <Slider Grid.Column="1" Value="{Binding LabelScale}"
                        Minimum="0.5" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                <TextBlock Grid.Column="2" Text="{Binding LabelScale, StringFormat={}{0:0.0}x}"
                           Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="34"/>
            </Grid>

            <CheckBox IsChecked="{Binding UseCustomBackground}">
                <TextBlock Text="Custom background color" TextWrapping="Wrap"/>
            </CheckBox>
            <TextBox Text="{Binding CustomBackgroundHex}" IsEnabled="{Binding UseCustomBackground}"
                      PlaceholderText="#RRGGBB"/>
        </StackPanel>

        <!-- ── Metadata ──────────────────────────────────────────── -->
        <Border Classes="section-sep"/>
        <TextBlock Text="METADATA" Classes="section-header"/>
        <StackPanel Spacing="10">

            <Grid x:Name="VerbosityRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Verbosity" Classes="row-label"/>
                <ComboBox Grid.Column="1" x:Name="MetaVerbosityBox"
                          SelectedIndex="{Binding MetaVerbosityIndex}"/>
            </Grid>

            <Grid x:Name="StyleRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Style" Classes="row-label"/>
                <ComboBox Grid.Column="1" x:Name="MetaStyleBox"
                          SelectedIndex="{Binding MetaStyleIndex}"/>
            </Grid>

        </StackPanel>

        <!-- ── Output ────────────────────────────────────────────── -->
        <Border Classes="section-sep"/>
        <TextBlock Text="OUTPUT" Classes="section-header"/>
        <StackPanel Spacing="10">

            <Grid x:Name="FormatRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Format" Classes="row-label"/>
                <ComboBox Grid.Column="1" x:Name="OutputFormatBox"
                          SelectedIndex="{Binding OutputFormatIndex}"/>
            </Grid>

            <Grid x:Name="ExportSizeRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Export size" Classes="row-label"/>
                <ComboBox Grid.Column="1" x:Name="ExportPresetBox"
                          SelectedIndex="{Binding ExportPresetIndex}"/>
            </Grid>

            <CheckBox IsChecked="{Binding ShowSwatches}">
                <TextBlock Text="Show color palette (swatches)" TextWrapping="Wrap"/>
            </CheckBox>
            <CheckBox IsChecked="{Binding HalfSize}" IsVisible="{Binding !IsMobile}"
                      ToolTip.Tip="Compress 2× — roughly 4× smaller file">
                <TextBlock Text="Half size (2× downscale)" TextWrapping="Wrap"/>
            </CheckBox>

            <Grid x:Name="WorkingQualityRow" Classes="settings-row" IsVisible="{Binding IsMobile}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Working size" Classes="row-label"/>
                <ComboBox Grid.Column="1" x:Name="WorkingQualityBox"
                          SelectedIndex="{Binding WorkingQualityIndex}"/>
            </Grid>

        </StackPanel>

        <!-- ── Photo metadata ────────────────────────────────────── -->
        <Border Classes="section-sep"/>
        <Grid ColumnDefinitions="*,50">
            <TextBlock Grid.Column="0" Text="PHOTO METADATA" Classes="section-header"/>
            <Border Grid.Column="1" Background="Transparent" Cursor="Hand"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,20,0,8"
                    Tapped="ToggleMetadataEditor_Tapped">
                <TextBlock Text="{Binding MetadataEditorToggleLabel}" FontSize="11"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </Border>
        </Grid>
        <!-- Only Camera/Lens/Focal/Aperture/Shutter/ISO/Date are editable — the strip's other
             fields (35mm-eq, exposure bias, white balance, exposure program, serial) always
             come straight from the photo's real EXIF. -->
        <StackPanel Spacing="10" IsVisible="{Binding IsMetadataEditorExpanded}">

            <Grid x:Name="MetaCameraRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Camera" Classes="row-label"/>
                <TextBox Grid.Column="1" Text="{Binding MetaCameraText}" PlaceholderText="e.g. Canon EOS R5"/>
            </Grid>

            <Grid x:Name="MetaLensRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Lens" Classes="row-label"/>
                <TextBox Grid.Column="1" Text="{Binding MetaLensText}" PlaceholderText="e.g. RF 24-70mm f/2.8"/>
            </Grid>

            <Grid x:Name="MetaFocalRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Focal" Classes="row-label"/>
                <TextBox Grid.Column="1" Text="{Binding MetaFocalText}" PlaceholderText="e.g. 50mm"/>
            </Grid>

            <Grid x:Name="MetaApertureRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Aperture" Classes="row-label"/>
                <TextBox Grid.Column="1" Text="{Binding MetaApertureText}" PlaceholderText="e.g. f/2.8"/>
            </Grid>

            <Grid x:Name="MetaShutterRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Shutter" Classes="row-label"/>
                <TextBox Grid.Column="1" Text="{Binding MetaShutterText}" PlaceholderText="e.g. 1/200s"/>
            </Grid>

            <Grid x:Name="MetaIsoRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="ISO" Classes="row-label"/>
                <TextBox Grid.Column="1" Text="{Binding MetaIsoText}" PlaceholderText="e.g. ISO 400"/>
            </Grid>

            <Grid x:Name="MetaDateRow" Classes="settings-row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabels"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="Date" Classes="row-label"/>
                <TextBox Grid.Column="1" Text="{Binding MetaDateText}" PlaceholderText="e.g. 2026-07-05"/>
            </Grid>

            <Button Classes="secondary" HorizontalAlignment="Left"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Content="Reset to photo's EXIF"
                    Command="{Binding ResetMetadataCommand}"/>

        </StackPanel>

        <!-- ── About ─────────────────────────────────────────────── -->
        <Border Classes="section-sep"/>
        <TextBlock Text="ABOUT" Classes="section-header"/>
        <StackPanel Spacing="10">
            <TextBlock Text="{Binding AppVersionText}" Opacity="0.6" FontSize="12"/>
            <!-- Desktop gets a dismissible toolbar banner instead (MainWindow.axaml) —
                 this row only matters where there's no toolbar to put that in. -->
            <Button Classes="text" IsVisible="{Binding ShowUpdateRow}" MinWidth="0" MinHeight="0" Padding="0"
                    HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                    Content="{Binding UpdateAvailableText}"
                    Command="{Binding OpenUpdateUrlCommand}"/>
        </StackPanel>

    </StackPanel>

</UserControl>
