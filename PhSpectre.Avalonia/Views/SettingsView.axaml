<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhSpectre.Avalonia.ViewModels"
        xmlns:views="using:PhSpectre.Avalonia.Views"
        x:Class="PhSpectre.Avalonia.Views.SettingsView"
        x:DataType="vm:SettingsViewModel"
        Width="450" Height="730"
        Title="Settings"
        CanResize="True"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer Padding="24,18,24,18" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="6">

            <views:SettingsPanel/>

            <Button Content="OK"
                    HorizontalAlignment="Right"
                    Click="OnOkClick"
                    Margin="0,14,0,0"
                    Padding="24,6"/>

        </StackPanel>
    </ScrollViewer>

</Window>
