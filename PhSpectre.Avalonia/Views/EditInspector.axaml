<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhSpectre.Avalonia.ViewModels"
             xmlns:rend="using:PhSpectre.Rendering"
             xmlns:local="using:PhSpectre.Avalonia.Views"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PhSpectre.Avalonia.Views.EditInspector"
             x:DataType="vm:ProcessViewModel">

    <UserControl.Styles>
        <Style Selector="Border.tile-img">
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Border.tile-img.active">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </UserControl.Styles>

    <!-- Edit inspector (DataContext = Settings.Process): Look · Frame · Export, one topic at a time. -->
    <Border Background="{DynamicResource PanelBrush}">
        <Grid RowDefinitions="Auto,*">

            <!-- Tabs -->
            <ListBox Grid.Row="0" Classes="seg" Margin="16,14,16,0" SelectedIndex="{Binding Settings.EditTab}">
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="PaletteOutline" Width="16" Height="16"/>
                        <TextBlock Text="Look"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="ImageFrame" Width="16" Height="16"/>
                        <TextBlock Text="Frame"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="TrayArrowDown" Width="16" Height="16"/>
                        <TextBlock Text="Export"/>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <!-- ═══════════ Look ═══════════ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding Settings.EditIsLook}">
                <StackPanel Margin="16,14,16,16" Spacing="12">
                    <local:SegmentedControl Labels="Looks|Crop|Exposure" SelectedIndex="{Binding LookSection}"/>

                    <!-- Crop and straighten -->
                    <StackPanel Spacing="12" IsVisible="{Binding LookIsCrop}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Crop and straighten" Classes="section-title first"/>
                            <Button Grid.Column="1" Classes="link" Content="Reset" IsVisible="{Binding HasGeometryAdjust}"
                                    Command="{Binding ResetGeometryCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="72,*">
                            <TextBlock Text="Ratio" Classes="hint" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding CropLabels}" SelectedIndex="{Binding CropIndex}"
                                      HorizontalAlignment="Stretch" AutomationProperties.Name="Crop ratio"/>
                        </Grid>
                        <Grid ColumnDefinitions="72,*,56">
                            <TextBlock Text="Straighten" Classes="hint" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Classes="v2" Minimum="-15" Maximum="15" Value="{Binding Straighten}"
                                    AutomationProperties.Name="Straighten"/>
                            <TextBlock Grid.Column="2" Text="{Binding StraightenText}" Classes="mono-data"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="72,*,56">
                            <TextBlock Text="Zoom" Classes="hint" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Classes="v2" Minimum="1" Maximum="4" Value="{Binding Zoom}"
                                    AutomationProperties.Name="Crop zoom"/>
                            <TextBlock Grid.Column="2" Text="{Binding ZoomText}" Classes="mono-data"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="72,*">
                            <TextBlock Text="Rotate" Classes="hint" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Classes="secondary" Height="36" Padding="12,0" Command="{Binding RotateLeftCommand}"
                                        ToolTip.Tip="Rotate 90° left" AutomationProperties.Name="Rotate left">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <materialIcons:MaterialIcon Kind="RotateLeft" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="90° left" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="secondary" Height="36" Padding="12,0" Command="{Binding RotateRightCommand}"
                                        ToolTip.Tip="Rotate 90° right" AutomationProperties.Name="Rotate right">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <materialIcons:MaterialIcon Kind="RotateRight" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="90° right" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Drag the photo to move the crop. It is cut to the largest area that stays full, so straightening never leaves empty corners."
                                   Classes="hint" TextWrapping="Wrap"/>
                        <TextBlock Text="Export all keeps the ratio; straighten, turn and zoom stay with this photo."
                                   Classes="hint" TextWrapping="Wrap" IsVisible="{Binding CanExportAll}"/>
                    </StackPanel>

                    <!-- Exposure -->
                    <StackPanel Spacing="12" IsVisible="{Binding LookIsExposure}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Exposure" Classes="section-title first"/>
                            <Button Grid.Column="1" Classes="link" Content="Reset" IsVisible="{Binding HasExposureAdjust}"
                                    Command="{Binding ResetExposureCommand}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,76">
                            <Slider Classes="v2" Minimum="-3" Maximum="3" Value="{Binding Exposure}" AutomationProperties.Name="Exposure"/>
                            <TextBlock Grid.Column="1" Text="{Binding ExposureText}" Classes="mono-data"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Brightens or darkens in stops, before the Look is applied. Export all applies it to every photo."
                                   Classes="hint" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Looks -->
                    <StackPanel Spacing="12" IsVisible="{Binding LookIsLooks}">

                    <!-- Amount -->
                    <StackPanel Spacing="4" IsVisible="{Binding HasLayers}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Amount" Classes="section-title first"/>
                            <TextBlock Grid.Column="1" Text="{Binding AmountText}" Classes="mono-data"/>
                        </Grid>
                        <Slider Classes="v2" Minimum="0" Maximum="100" Value="{Binding Amount}"
                                AutomationProperties.Name="Look amount"/>
                    </StackPanel>

                    <!-- Layers -->
                    <local:LayerRow IsVisible="{Binding HasPreset}" Kind="Preset" IsOn="{Binding PresetEnabled}" LayerName="{Binding PresetName}"
                                ClearCommand="{Binding ClearPresetCommand}"/>
                    <local:LayerRow IsVisible="{Binding HasLut}" Kind="LUT" IsOn="{Binding LutEnabled}" LayerName="{Binding LutName}"
                                ClearCommand="{Binding ClearLutCommand}"/>
                    <TextBlock Text="{Binding SkippedText}" IsVisible="{Binding HasSkipped}"
                               Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="Applying a Look turns off Recipe card." Classes="hint"
                               IsVisible="{Binding Settings.IsRecipeCardType}"/>

                    <!-- Search, filter, import -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Text="{Binding SearchText}" Watermark="Search looks" AutomationProperties.Name="Search looks"/>
                        <Button Grid.Column="1" x:Name="ImportButton" Classes="secondary" Height="36" Padding="12,0"
                                ToolTip.Tip="Import .cube, .xmp or a .zip of them" AutomationProperties.Name="Import">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Import" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <local:SegmentedControl Labels="All|Fav|Presets|LUTs" SelectedIndex="{Binding LibraryTab}"/>

                    <Border IsVisible="{Binding HasImportStatus}" Background="{DynamicResource ControlBrush}"
                            CornerRadius="8" Padding="10,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding ImportStatus}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Button Grid.Column="1" Classes="icon-toolbar" Width="24" Height="24" VerticalAlignment="Top"
                                    Command="{Binding DismissImportStatusCommand}" AutomationProperties.Name="Dismiss">
                                <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Empty library -->
                    <TextBlock Text="{Binding LibraryEmptyText}" Classes="hint" TextWrapping="Wrap" Margin="0,8"
                               IsVisible="{Binding ShowLibraryEmpty}"/>

                    <!-- Look tiles: the user's own photo with each Look applied -->
                    <ItemsControl ItemsSource="{Binding Groups}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GradeGroup">
                          <StackPanel Spacing="8" Margin="0,0,0,6">
                            <TextBlock Text="{Binding Name}" Classes="section-title"/>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GradeItemViewModel">
                                <Button Width="96" Margin="0,0,12,10" Padding="0"
                                        HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                        Command="{Binding Owner.UseItemCommand}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Name}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Favorite" Command="{Binding Owner.ToggleFavoriteCommand}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="Delete from library" IsVisible="{Binding CanDelete}" Command="{Binding Owner.DeleteItemCommand}" CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel Spacing="3">
                                        <Border Classes="tile-img" Classes.active="{Binding IsActive}"
                                                Width="96" Height="72" CornerRadius="10" ClipToBounds="True"
                                                Background="{DynamicResource SurfaceBrush}" BorderThickness="2">
                                            <Panel>
                                                <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                                <TextBlock Text="…" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           IsVisible="{Binding !HasThumb}" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <materialIcons:MaterialIcon Kind="Star" Width="14" Height="14" Margin="5"
                                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                            Foreground="{DynamicResource AccentBrush}"
                                                                            IsVisible="{Binding IsFavorite}"/>
                                            </Panel>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════ Frame (None · Border here; Card · Recipe card open the card layout) ═══════════ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding Settings.EditIsFrame}">
                <StackPanel Margin="16,14,16,16" Spacing="12">
                    <TextBlock Text="Frame type" Classes="section-title first"/>
                    <ListBox Classes="seg" SelectedIndex="{Binding Settings.FrameTypeIndex}">
                        <ListBoxItem Content="None"/>
                        <ListBoxItem Content="Border"/>
                        <ListBoxItem Content="Card"/>
                        <ListBoxItem Content="Recipe" IsEnabled="{Binding Settings.RecipeCardAvailable}"/>
                        <ListBoxItem Content="Film"/>
                    </ListBox>
                    <TextBlock Text="{Binding Settings.RecipeCardReason}" Classes="hint" TextWrapping="Wrap"
                               IsVisible="{Binding Settings.ShowRecipeCardReason}"/>
                    <TextBlock Text="{Binding Settings.FrameNotice}" Foreground="{DynamicResource WarningBrush}"
                               FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Settings.HasFrameNotice}"/>

                    <TextBlock Text="Card and Recipe card add a palette, camera info or the film recipe under the photo."
                               Classes="hint" TextWrapping="Wrap" IsVisible="{Binding Settings.ShowCardHint}"/>

                    <!-- Border -->
                    <StackPanel Spacing="10" IsVisible="{Binding Settings.FrameIsBorder}">
                        <ComboBox ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}"
                                  PlaceholderText="Custom" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Border style">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="rend:PhotoFrame">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Expander Header="Customize" IsExpanded="False" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="10" Margin="0,8,0,0">
                                <Grid ColumnDefinitions="72,*,44">
                                    <TextBlock Text="Border" Classes="hint" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Classes="v2" Minimum="0" Maximum="30" Value="{Binding FrameThickness}"
                                            AutomationProperties.Name="Border thickness"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FrameThicknessText}" Classes="mono-data"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="72,*,44">
                                    <TextBlock Text="Bottom" Classes="hint" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Classes="v2" Minimum="0" Maximum="40" Value="{Binding FrameBottom}"
                                            AutomationProperties.Name="Extra space below the photo"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FrameBottomText}" Classes="mono-data"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="72,*">
                                    <TextBlock Text="Ratio" Classes="hint" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AspectLabels}"
                                              SelectedIndex="{Binding FrameAspectIndex}" HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="Canvas ratio"/>
                                </Grid>
                                <Grid ColumnDefinitions="72,*">
                                    <TextBlock Text="Color" Classes="hint" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <local:ColorSwatch Color="#FFFFFF" Command="{Binding SetFrameColorCommand}" AutomationProperties.Name="White"/>
                                            <local:ColorSwatch Color="#F4F1EA" Command="{Binding SetFrameColorCommand}" AutomationProperties.Name="Cream"/>
                                            <local:ColorSwatch Color="#808080" Command="{Binding SetFrameColorCommand}" AutomationProperties.Name="Grey"/>
                                            <local:ColorSwatch Color="#000000" Command="{Binding SetFrameColorCommand}" AutomationProperties.Name="Black"/>
                                        </StackPanel>
                                        <TextBox Text="{Binding FrameColorHex}" Watermark="#RRGGBB" MaxLength="7"
                                                 AutomationProperties.Name="Border color hex"/>
                                        <TextBlock Text="Use #RRGGBB" IsVisible="{Binding FrameColorInvalid}"
                                                   Foreground="{DynamicResource ErrorBrush}" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                                <local:SaveRow Text="{Binding FrameName}" NameLabel="Name for the custom border" SaveCommand="{Binding SaveFrameCommand}"
                                    DeleteCommand="{Binding DeleteFrameCommand}" CanDelete="{Binding CanDeleteFrame}" DeleteTip="Delete saved border"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- Film: shot data printed on a film edge, laid out per zone -->
                    <StackPanel Spacing="10" IsVisible="{Binding Settings.FrameIsFilm}">
                        <ComboBox ItemsSource="{Binding FilmStyles}" SelectedItem="{Binding SelectedFilm}"
                                  PlaceholderText="Custom" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Film style">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="rend:FilmStyle">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Each spot on the film edge prints one short piece of data. Anything the photo doesn't carry is left blank."
                                   Classes="hint" TextWrapping="Wrap"/>
                        <Expander Header="Data on the edge" IsExpanded="False" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <local:ChoiceRow Label="Top left" ItemsSource="{Binding FilmContentLabels}" SelectedIndex="{Binding FilmTopLeftIndex}"
                                                AccessibleName="Top left of the edge"/>
                                <local:ChoiceRow Label="Top right" ItemsSource="{Binding FilmContentLabels}" SelectedIndex="{Binding FilmTopRightIndex}"
                                                AccessibleName="Top right of the edge"/>
                                <local:ChoiceRow Label="Top" ItemsSource="{Binding FilmContentLabels}" SelectedIndex="{Binding FilmTopCenterIndex}"
                                                AccessibleName="Top of the edge"/>
                                <local:ChoiceRow Label="Bottom left" ItemsSource="{Binding FilmContentLabels}" SelectedIndex="{Binding FilmBottomLeftIndex}"
                                                AccessibleName="Bottom left of the edge"/>
                                <local:ChoiceRow Label="Bottom" ItemsSource="{Binding FilmContentLabels}" SelectedIndex="{Binding FilmBottomCenterIndex}"
                                                AccessibleName="Bottom centre of the edge"/>
                                <local:ChoiceRow Label="Bottom right" ItemsSource="{Binding FilmContentLabels}" SelectedIndex="{Binding FilmBottomRightIndex}"
                                                AccessibleName="Bottom right of the edge"/>
                                <local:ChoiceRow Label="Left side" ItemsSource="{Binding FilmContentLabels}" SelectedIndex="{Binding FilmSideLeftIndex}"
                                                AccessibleName="Left side of the edge"/>
                                <local:ChoiceRow Label="Right side" ItemsSource="{Binding FilmContentLabels}" SelectedIndex="{Binding FilmSideRightIndex}"
                                                AccessibleName="Right side of the edge"/>
                                <local:ChoiceRow Label="Between holes" ItemsSource="{Binding FilmContentLabels}" SelectedIndex="{Binding FilmHoleGapsIndex}"
                                                AccessibleName="Between the sprocket holes (needs sprockets)"/>
                                <Grid ColumnDefinitions="84,*,Auto,Auto,Auto" ColumnSpacing="6">
                                    <TextBlock Text="Frame no." Classes="hint" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding FilmFrameText}" Watermark="{Binding FilmFrameWatermark}" MaxLength="6"
                                             AutomationProperties.Name="Frame number printed on the edge (empty = automatic)"/>
                                    <Button Grid.Column="2" Classes="secondary" Width="40" Height="40" Padding="0" FontSize="18" Content="−"
                                            Command="{Binding FilmFrameStepCommand}" CommandParameter="-1"
                                            ToolTip.Tip="Previous number" AutomationProperties.Name="Decrease frame number"/>
                                    <Button Grid.Column="3" Classes="secondary" Width="40" Height="40" Padding="0" FontSize="18" Content="+"
                                            Command="{Binding FilmFrameStepCommand}" CommandParameter="1"
                                            ToolTip.Tip="Next number" AutomationProperties.Name="Increase frame number"/>
                                    <Button Grid.Column="4" Classes="secondary" Height="40" Padding="12,0" Margin="2,0,0,0" Content="Auto"
                                            Command="{Binding FilmFrameAutoResetCommand}" IsEnabled="{Binding FilmFrameIsManual}"
                                            ToolTip.Tip="Take the number from the file name again" AutomationProperties.Name="Automatic frame number"/>
                                </Grid>
                                <Grid ColumnDefinitions="84,*">
                                    <TextBlock Text="Custom text" Classes="hint" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding FilmCustomText}" Watermark="e.g. Portra 400" MaxLength="40"
                                             AutomationProperties.Name="Custom text printed on the edge"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                        <Expander Header="Look of the edge" IsExpanded="False" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="10" Margin="0,8,0,0">
                                <Grid ColumnDefinitions="72,*,44">
                                    <TextBlock Text="Sides" Classes="hint" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Classes="v2" Minimum="0" Maximum="35" Value="{Binding FilmSide}"
                                            AutomationProperties.Name="Side edge width"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FilmSideText}" Classes="mono-data"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="72,*,44">
                                    <TextBlock Text="Top" Classes="hint" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Classes="v2" Minimum="0" Maximum="35" Value="{Binding FilmTop}"
                                            AutomationProperties.Name="Top edge height"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FilmTopText}" Classes="mono-data"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="72,*,44">
                                    <TextBlock Text="Bottom" Classes="hint" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Classes="v2" Minimum="0" Maximum="35" Value="{Binding FilmBottom}"
                                            AutomationProperties.Name="Bottom edge height"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FilmBottomText}" Classes="mono-data"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="72,*,44">
                                    <TextBlock Text="Film feel" Classes="hint" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Classes="v2" Minimum="0" Maximum="100" Value="{Binding FilmRealism}"
                                            AutomationProperties.Name="Film feel: grain, uneven light, soft holes"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FilmRealismText}" Classes="mono-data"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="72,*,44">
                                    <TextBlock Text="Dust" Classes="hint" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Classes="v2" Minimum="0" Maximum="100" Value="{Binding FilmDust}"
                                            AutomationProperties.Name="Dust and scratches"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FilmDustText}" Classes="mono-data"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="72,*,44">
                                    <TextBlock Text="Corners" Classes="hint" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Classes="v2" Minimum="0" Maximum="4" Value="{Binding FilmCorner}"
                                            AutomationProperties.Name="Rounded photo corners"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FilmCornerText}" Classes="mono-data"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="72,*">
                                    <TextBlock Text="Sprockets" Classes="hint" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding FilmPerforationLabels}"
                                              SelectedIndex="{Binding FilmPerforationIndex}" HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="Sprocket holes"/>
                                </Grid>
                                <Grid ColumnDefinitions="72,*">
                                    <TextBlock Text="Holes" Classes="hint" VerticalAlignment="Center"/>
                                    <ListBox Grid.Column="1" Classes="seg" SelectedIndex="{Binding FilmHoleIndex}"
                                             AutomationProperties.Name="Sprocket hole colour">
                                        <ListBoxItem Content="Black"/>
                                        <ListBoxItem Content="White"/>
                                    </ListBox>
                                </Grid>
                                <Grid ColumnDefinitions="72,*">
                                    <TextBlock Text="Edge" Classes="hint" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <local:ColorSwatch Color="#0B0B0B" Command="{Binding SetFilmEdgeColorCommand}" AutomationProperties.Name="Black"/>
                                            <local:ColorSwatch Color="#16100C" Command="{Binding SetFilmEdgeColorCommand}" AutomationProperties.Name="Dark brown"/>
                                            <local:ColorSwatch Color="#8E9298" Command="{Binding SetFilmEdgeColorCommand}" AutomationProperties.Name="Grey"/>
                                            <local:ColorSwatch Color="#F4F1EA" Command="{Binding SetFilmEdgeColorCommand}" AutomationProperties.Name="Cream"/>
                                        </StackPanel>
                                        <TextBox Text="{Binding FilmEdgeHex}" Watermark="#RRGGBB" MaxLength="7"
                                                 AutomationProperties.Name="Edge color hex"/>
                                        <TextBlock Text="Use #RRGGBB" IsVisible="{Binding FilmEdgeInvalid}"
                                                   Foreground="{DynamicResource ErrorBrush}" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="72,*">
                                    <TextBlock Text="Text" Classes="hint" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <local:ColorSwatch Color="#F2F2F2" Command="{Binding SetFilmTextColorCommand}" AutomationProperties.Name="White"/>
                                            <local:ColorSwatch Color="#FFB020" Command="{Binding SetFilmTextColorCommand}" AutomationProperties.Name="Amber"/>
                                            <local:ColorSwatch Color="#2A2C30" Command="{Binding SetFilmTextColorCommand}" AutomationProperties.Name="Dark grey"/>
                                        </StackPanel>
                                        <TextBox Text="{Binding FilmTextHex}" Watermark="#RRGGBB" MaxLength="7"
                                                 AutomationProperties.Name="Text color hex"/>
                                        <TextBlock Text="Use #RRGGBB" IsVisible="{Binding FilmTextInvalid}"
                                                   Foreground="{DynamicResource ErrorBrush}" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox Content="Glow (backlit look)" IsChecked="{Binding FilmGlow}"/>
                                <local:SaveRow Text="{Binding FilmName}" NameLabel="Name for the custom film style" SaveCommand="{Binding SaveFilmCommand}"
                                    DeleteCommand="{Binding DeleteFilmCommand}" CanDelete="{Binding CanDeleteFilm}" DeleteTip="Delete saved film style"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- Card / Recipe card: the same options as before, tucked into two sections -->
                    <StackPanel Spacing="10" DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel"
                                IsVisible="{Binding FrameIsCardType}">
                        <Expander Header="Style" IsExpanded="False" HorizontalAlignment="Stretch">
                            <local:CardStyleSection Margin="0,8,0,0"/>
                        </Expander>
                        <Expander Header="Content" IsExpanded="False" HorizontalAlignment="Stretch">
                            <local:CardContentSection Margin="0,8,0,0"/>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════ Export ═══════════ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding Settings.EditIsExport}">
                <StackPanel Margin="16,14,16,16" Spacing="14">
                    <StackPanel Spacing="14">
                    <TextBlock Text="Format" Classes="section-title first"/>
                    <ListBox Classes="seg" SelectedIndex="{Binding ExportFormatIndex}">
                        <ListBoxItem Content="JPEG"/>
                        <ListBoxItem Content="PNG"/>
                    </ListBox>
                    <StackPanel Spacing="4" IsVisible="{Binding ExportIsJpeg}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Quality" Classes="section-title first" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ExportQualityText}" Classes="mono-data" VerticalAlignment="Center"/>
                        </Grid>
                        <Slider Classes="v2" Minimum="50" Maximum="100" Value="{Binding ExportQuality}"
                                AutomationProperties.Name="JPEG quality"/>
                    </StackPanel>
                    <!-- Size and Save to: the same for every frame -->
                    <local:CardExportSection DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel" Margin="0,-8,0,-20"/>
                    <TextBlock Text="The original file is never changed." Classes="hint" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ExportStatus}" IsVisible="{Binding HasExportStatus}" Classes="hint" TextWrapping="Wrap"/>
                    <Button x:Name="ExportButton" Classes="primary" Height="44" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" IsEnabled="{Binding CanExport}"
                            Content="{Binding ExportButtonText}"/>
                    <Button x:Name="ExportAllButton" Classes="secondary" Height="40" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" IsEnabled="{Binding CanExportAll}"
                            IsVisible="{Binding CanExportAll}" Content="{Binding ExportAllText}"/>
                    </StackPanel>

                    <!-- Write recipes into a Fujifilm camera over USB: only offered while one is connected -->
                    <local:ActionButton Classes="secondary" Height="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            IsVisible="{Binding Settings.Camera.IsTabConnected}" Command="{Binding Settings.OpenCameraCommand}"
                            AutomationProperties.Name="Connect camera" Icon="CameraOutline" IconSize="16" Text="Write recipes to camera…"/>
                </StackPanel>
            </ScrollViewer>
            <local:RecipeEditorView Grid.RowSpan="2" DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel"
                                    IsVisible="{Binding IsRecipeEditorOpen}"/>
        </Grid>
    </Border>
</UserControl>
