<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:PhSpectre.Avalonia.Localization"
             xmlns:vm="using:PhSpectre.Avalonia.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PhSpectre.Avalonia.Views.EditToolRail"
             x:DataType="vm:ProcessViewModel">
    <!-- Tool rail for desktop and tablet; DataContext = Settings.Process. -->
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
        <ListBox Classes="seg" Margin="6,12" Width="52" VerticalAlignment="Top"
                 SelectedIndex="{Binding EditSection}" AutomationProperties.Name="{l:T 'Edit tools'}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Vertical" Spacing="2"/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBoxItem Padding="0" MinHeight="44" ToolTip.Tip="{l:T 'Looks'}" AutomationProperties.Name="{l:T 'Looks'}">
                <materialIcons:MaterialIcon Kind="PaletteOutline" Width="22" Height="22"/>
            </ListBoxItem>
            <ListBoxItem Padding="0" MinHeight="44" ToolTip.Tip="{l:T 'Crop'}" AutomationProperties.Name="{l:T 'Crop'}">
                <materialIcons:MaterialIcon Kind="Crop" Width="22" Height="22"/>
            </ListBoxItem>
            <ListBoxItem Padding="0" MinHeight="44" ToolTip.Tip="{l:T 'Light'}" AutomationProperties.Name="{l:T 'Light'}">
                <materialIcons:MaterialIcon Kind="Brightness6" Width="22" Height="22"/>
            </ListBoxItem>
            <ListBoxItem Padding="0" MinHeight="44" ToolTip.Tip="{l:T 'Color'}" AutomationProperties.Name="{l:T 'Color'}">
                <materialIcons:MaterialIcon Kind="Thermometer" Width="22" Height="22"/>
            </ListBoxItem>
            <ListBoxItem Padding="0" MinHeight="44" ToolTip.Tip="{l:T 'Effects'}" AutomationProperties.Name="{l:T 'Effects'}">
                <materialIcons:MaterialIcon Kind="AutoFix" Width="22" Height="22"/>
            </ListBoxItem>
            <ListBoxItem Padding="0" MinHeight="44" ToolTip.Tip="{l:T 'Frame'}" AutomationProperties.Name="{l:T 'Frame'}">
                <materialIcons:MaterialIcon Kind="ImageFrame" Width="22" Height="22"/>
            </ListBoxItem>
            <ListBoxItem Padding="0" MinHeight="44" ToolTip.Tip="{l:T 'Export'}" AutomationProperties.Name="{l:T 'Export'}">
                <materialIcons:MaterialIcon Kind="TrayArrowDown" Width="22" Height="22"/>
            </ListBoxItem>
        </ListBox>
    </Border>
</UserControl>
