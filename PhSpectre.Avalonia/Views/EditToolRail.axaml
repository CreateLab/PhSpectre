<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhSpectre.Avalonia.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PhSpectre.Avalonia.Views.EditToolRail"
             x:DataType="vm:ProcessViewModel">
    <!-- Edit tools as a rail pressed against the left edge, beside the photo (desktop, tablet). DataContext = Settings.Process. -->
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
        <ListBox Classes="seg" Margin="6,12" Width="52" VerticalAlignment="Top"
                 SelectedIndex="{Binding EditSection}" AutomationProperties.Name="Edit tools">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Vertical" Spacing="2"/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBoxItem Padding="0" MinHeight="44" ToolTip.Tip="Looks" AutomationProperties.Name="Looks">
                <materialIcons:MaterialIcon Kind="PaletteOutline" Width="22" Height="22"/>
            </ListBoxItem>
            <ListBoxItem Padding="0" MinHeight="44" ToolTip.Tip="Crop" AutomationProperties.Name="Crop">
                <materialIcons:MaterialIcon Kind="Crop" Width="22" Height="22"/>
            </ListBoxItem>
            <ListBoxItem Padding="0" MinHeight="44" ToolTip.Tip="Light" AutomationProperties.Name="Light">
                <materialIcons:MaterialIcon Kind="Brightness6" Width="22" Height="22"/>
            </ListBoxItem>
            <ListBoxItem Padding="0" MinHeight="44" ToolTip.Tip="Color" AutomationProperties.Name="Color">
                <materialIcons:MaterialIcon Kind="Thermometer" Width="22" Height="22"/>
            </ListBoxItem>
            <ListBoxItem Padding="0" MinHeight="44" ToolTip.Tip="Effects" AutomationProperties.Name="Effects">
                <materialIcons:MaterialIcon Kind="AutoFix" Width="22" Height="22"/>
            </ListBoxItem>
            <ListBoxItem Padding="0" MinHeight="44" ToolTip.Tip="Frame" AutomationProperties.Name="Frame">
                <materialIcons:MaterialIcon Kind="ImageFrame" Width="22" Height="22"/>
            </ListBoxItem>
            <ListBoxItem Padding="0" MinHeight="44" ToolTip.Tip="Export" AutomationProperties.Name="Export">
                <materialIcons:MaterialIcon Kind="TrayArrowDown" Width="22" Height="22"/>
            </ListBoxItem>
        </ListBox>
    </Border>
</UserControl>
