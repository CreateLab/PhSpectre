<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PhSpectre.Avalonia.ViewModels"
             xmlns:views="using:PhSpectre.Avalonia.Views"
             xmlns:models="using:PhSpectre.Avalonia.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="PhSpectre.Avalonia.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <!--
        V2 mobile / tablet layout (png/V2-Mobile, png/V2-Tablet).
        Phone  (< 840 dp): top bar, Card / Recipe / Collage, stage, filmstrip, [Adjust] [Export];
                           the inspector opens as a bottom sheet with the same three tabs.
        Tablet (≥ 840 dp): the inspector is a permanent column on the right, like desktop.
        MainView.axaml.cs flips MainViewModel.IsWide from the available width.
    -->
    <Panel x:Name="RootPanel" Background="{DynamicResource BackgroundBrush}">

        <Grid RowDefinitions="Auto,Auto,*">

            <!-- ═══════════ Top bar ═══════════ -->
            <Border Grid.Row="0" Padding="16,10" Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto,*">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Image Source="/Assets/PhSpectre.ico" Width="26" Height="26"/>
                        <TextBlock Text="PhSpectre" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Tablet: modes live in the top bar -->
                    <ListBox Grid.Column="1" Classes="seg touch" Width="420" VerticalAlignment="Center"
                             IsVisible="{Binding IsWide}" SelectedIndex="{Binding Settings.TopModeSelection}">
                        <ListBoxItem Content="Card"/>
                        <ListBoxItem Content="Recipe"/>
                        <ListBoxItem Content="Collage"/>
                    </ListBox>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Classes="icon-toolbar" Width="40" Height="40" ToolTip.Tip="Appearance">
                            <materialIcons:MaterialIcon Kind="ThemeLightDark" Width="20" Height="20"/>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Width="230" Spacing="2" DataContext="{Binding Settings}"
                                                x:DataType="vm:SettingsViewModel">
                                        <TextBlock Text="APPEARANCE" Classes="section-title first" Margin="4,4,0,6"/>
                                        <RadioButton Content="System" GroupName="appearance" MinHeight="44"
                                                     IsChecked="{Binding IsAppearanceSystem, Mode=OneWay}"
                                                     Command="{Binding SetAppearanceCommand}"
                                                     CommandParameter="{x:Static vm:AppAppearance.System}"/>
                                        <RadioButton Content="Light" GroupName="appearance" MinHeight="44"
                                                     IsChecked="{Binding IsAppearanceLight, Mode=OneWay}"
                                                     Command="{Binding SetAppearanceCommand}"
                                                     CommandParameter="{x:Static vm:AppAppearance.Light}"/>
                                        <RadioButton Content="Dark" GroupName="appearance" MinHeight="44"
                                                     IsChecked="{Binding IsAppearanceDark, Mode=OneWay}"
                                                     Command="{Binding SetAppearanceCommand}"
                                                     CommandParameter="{x:Static vm:AppAppearance.Dark}"/>
                                        <TextBlock Classes="hint" Margin="4,6,4,4"
                                                   Text="Applies to the app. The exported card has its own theme in Style → Card."/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Classes="icon-toolbar" Width="40" Height="40" Command="{Binding PickMainPhotoCommand}"
                                ToolTip.Tip="Pick a photo">
                            <materialIcons:MaterialIcon Kind="FolderOutline" Width="20" Height="20"/>
                        </Button>
                        <Button Classes="cta" Padding="18,0" Height="40" IsVisible="{Binding IsWide}"
                                Command="{Binding OpenExportCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="TrayArrowDown" Width="18" Height="18"/>
                                <TextBlock Text="Export" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Phone: modes under the top bar -->
            <ListBox Grid.Row="1" Classes="seg touch" Margin="16,12,16,4" IsVisible="{Binding IsPhone}"
                     SelectedIndex="{Binding Settings.TopModeSelection}">
                <ListBoxItem Content="Card"/>
                <ListBoxItem Content="Recipe"/>
                <ListBoxItem Content="Collage"/>
            </ListBox>

            <!-- ═══════════ Body ═══════════ -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">

                <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,Auto,Auto">

                    <!-- Collage tray: order = packing order, the first photo supplies the EXIF -->
                    <Border Grid.Row="0" IsVisible="{Binding IsCollageMode}" Padding="16,10,16,8">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding PhotosHeaderText}" Classes="section-title first" Margin="0"/>
                                <TextBlock Grid.Column="1" Text="Use ‹ › to reorder" Classes="hint"/>
                            </Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ItemsControl x:Name="CollageTrayItems" ItemsSource="{Binding CollageItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:FileEntry">
                                                <Border Width="76" Height="76" CornerRadius="10" ClipToBounds="True"
                                                        Background="{DynamicResource SurfaceBrush}">
                                                    <Panel>
                                                        <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill"/>
                                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                                                                Background="#CC000000" CornerRadius="3" Padding="4,1"
                                                                IsVisible="{Binding IsCollageExifSource}">
                                                            <TextBlock Text="EXIF" FontSize="9" Foreground="White"/>
                                                        </Border>
                                                        <Button Classes="tray-overlay" Width="24" Height="24" Padding="0"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3"
                                                                Command="{Binding #CollageTrayItems.((vm:MainViewModel)DataContext).RemoveFromCollageCommand}"
                                                                CommandParameter="{Binding}">
                                                            <materialIcons:MaterialIcon Kind="Close" Width="13" Height="13"/>
                                                        </Button>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                    Margin="3" Spacing="2">
                                                            <Button Classes="tray-overlay" Width="24" Height="24" Padding="0"
                                                                    Command="{Binding #CollageTrayItems.((vm:MainViewModel)DataContext).MoveCollageItemUpCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <materialIcons:MaterialIcon Kind="ChevronLeft" Width="13" Height="13"/>
                                                            </Button>
                                                            <Button Classes="tray-overlay" Width="24" Height="24" Padding="0"
                                                                    Command="{Binding #CollageTrayItems.((vm:MainViewModel)DataContext).MoveCollageItemDownCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <materialIcons:MaterialIcon Kind="ChevronRight" Width="13" Height="13"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Panel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Width="76" Height="76" Padding="0" Background="Transparent"
                                            Command="{Binding AddPhotosToCollageCommand}" ToolTip.Tip="Add photos"
                                            BorderThickness="1" BorderBrush="{DynamicResource FieldBorderBrush}" CornerRadius="10">
                                        <materialIcons:MaterialIcon Kind="Plus" Width="24" Height="24"
                                                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Stage -->
                    <Panel Grid.Row="1" Background="{DynamicResource StageBrush}" ClipToBounds="True" MinHeight="200">

                        <Panel Margin="16,16,16,64">
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                    BoxShadow="0 14 36 0 #66000000" CornerRadius="2">
                                <Image Source="{Binding DisplayedResultBitmap}" Stretch="Uniform"
                                       Opacity="{Binding ResultPreviewOpacity}"/>
                            </Border>
                        </Panel>

                        <!-- Empty state: the whole zone opens the picker -->
                        <Button IsVisible="{Binding ShowPlaceholder}" Command="{Binding PickForEmptyStateCommand}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" BorderThickness="0">
                            <StackPanel Spacing="12" HorizontalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="ImagePlusOutline" Width="40" Height="40"
                                                             Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding EmptyStageText}" Classes="hint" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <StackPanel IsVisible="{Binding ShowGeneratingIndicator}" Spacing="10" Width="180"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Height="3"/>
                            <TextBlock Text="Generating…" Classes="hint" TextAlignment="Center"/>
                        </StackPanel>

                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Spacing="10" Margin="12,12,12,0">
                        <views:ErrorCard IsVisible="{Binding HasError}" Message="{Binding ErrorMessage}"
                                         TryAgainCommand="{Binding RetryRenderCommand}"
                                         DismissCommand="{Binding DismissErrorCommand}"/>
                        <!-- Recipe mode without a recipe in the photo -->
                        <Border Classes="pill" IsVisible="{Binding Settings.ShowNoRecipeHint}" Padding="14,10"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <TextBlock Classes="hint" VerticalAlignment="Center" Text="No film recipe found"/>
                                <Button Classes="link" Content="Set manually" VerticalAlignment="Center"
                                        Command="{Binding Settings.SetRecipeManuallyCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                        <!-- Pill -->
                        <Border Classes="pill" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Padding="10,6"
                                IsVisible="{Binding ShowPill}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                            IsVisible="{Binding ShowUpdatingPill}">
                                    <ProgressBar IsIndeterminate="True" Width="36" Height="3"/>
                                    <TextBlock Text="Updating…" FontSize="12" Foreground="{DynamicResource WarningBrush}"/>
                                </StackPanel>
                                <ListBox Classes="seg" Width="170" IsVisible="{Binding CanCompare}"
                                         SelectedIndex="{Binding CompareIndex}">
                                    <ListBoxItem Content="Result"/>
                                    <ListBoxItem Content="Original"/>
                                </ListBox>
                            <Button Classes="cta" Height="30" Padding="14,0" FontSize="12" IsVisible="{Binding ShowRegenerate}"
                                    Command="{Binding RegenerateCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="14" Height="14"/>
                                    <TextBlock Text="{Binding RegenerateButtonLabel}"/>
                                </StackPanel>
                            </Button>
                            </StackPanel>
                        </Border>

                        <!-- Saved toast -->
                        <Border Classes="toast" IsVisible="{Binding IsSaved}" Padding="12,10"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,60">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource SuccessBrush}">
                                    <materialIcons:MaterialIcon Kind="Check" Width="16" Height="16"
                                                                 Foreground="{DynamicResource AccentInkBrush}"/>
                                </Border>
                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OutputSizeText, StringFormat='Saved · {0}'}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Photos · PhSpectre" Classes="value" FontWeight="Normal" FontSize="11" Opacity="0.7"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Panel>

                    <!-- Filmstrip (single-photo modes): this session's photos -->
                    <Border Grid.Row="2" IsVisible="{Binding !IsCollageMode}" Background="{DynamicResource FilmstripBrush}"
                            Padding="16,8,16,8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ItemsControl ItemsSource="{Binding RecentPhotos}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:FileEntry">
                                            <Button Classes="film" Classes.current="{Binding IsCurrent}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectRecentPhotoCommand}"
                                                    CommandParameter="{Binding}">
                                                <Border Width="72" Height="52" CornerRadius="6" ClipToBounds="True"
                                                        Background="{DynamicResource SurfaceBrush}">
                                                    <Panel>
                                                        <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill"/>
                                                        <Border Width="18" Height="18" CornerRadius="9" Margin="3"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Background="{DynamicResource SuccessBrush}"
                                                                IsVisible="{Binding IsExported}">
                                                            <materialIcons:MaterialIcon Kind="Check" Width="12" Height="12"
                                                                                         Foreground="{DynamicResource AccentInkBrush}"/>
                                                        </Border>
                                                    </Panel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Classes="film" Command="{Binding PickPhotoCommand}" ToolTip.Tip="Add a photo">
                                    <Border Width="72" Height="52" CornerRadius="6" BorderThickness="1"
                                            BorderBrush="{DynamicResource FieldBorderBrush}">
                                        <materialIcons:MaterialIcon Kind="Plus" Width="20" Height="20"
                                                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Phone: Adjust / Export -->
                    <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="16,8,16,14"
                          IsVisible="{Binding IsPhone}">
                        <Button Grid.Column="0" Classes="primary" Height="48" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding OpenAdjustCommand}"
                                IsVisible="{Binding !IsSheetOpen}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="TuneVariant" Width="18" Height="18"/>
                                <TextBlock Text="Adjust" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="cta" Height="48" HorizontalAlignment="Stretch"
                                Command="{Binding OpenExportCommand}" IsVisible="{Binding !IsSheetOpen}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="TrayArrowDown" Width="18" Height="18"/>
                                <TextBlock Text="Export"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Phone: bottom sheet (Adjust / Export). The stage above stays visible and live. -->
                    <Border Grid.Row="4" IsVisible="{Binding ShowSheet}" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0"
                            CornerRadius="20,20,0,0" Height="430">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,8,8,0">
                                <Border Grid.ColumnSpan="2" Width="40" Height="4" CornerRadius="2" HorizontalAlignment="Center"
                                        VerticalAlignment="Top" Margin="0,2,0,0" Background="{DynamicResource CardBorderBrush}"/>
                                <Button Grid.Column="1" Classes="icon-toolbar" Width="36" Height="36"
                                        Command="{Binding CloseSheetCommand}" ToolTip.Tip="Close">
                                    <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18"/>
                                </Button>
                            </Grid>
                            <views:SettingsPanel Grid.Row="1" DataContext="{Binding Settings}" Margin="16,4,10,0"/>
                            <Border Grid.Row="2" IsVisible="{Binding Settings.IsExportTab}" Padding="16,10,16,14"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding SuggestedNameText}" Classes="value" FontWeight="Normal"
                                                   Opacity="0.8" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding OutputSizeText}" Classes="value" FontWeight="Normal"
                                                   Opacity="0.8"/>
                                    </Grid>
                                    <Button Classes="cta" Height="48" HorizontalAlignment="Stretch"
                                            Command="{Binding SavePngCommand}" Content="{Binding SaveButtonText}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Tablet: permanent inspector -->
                <Border Grid.Column="1" Width="344" IsVisible="{Binding IsWide}" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0">
                    <Grid RowDefinitions="*,Auto">
                        <views:SettingsPanel Grid.Row="0" DataContext="{Binding Settings}" Margin="16,14,10,0"/>
                        <Border Grid.Row="1" IsVisible="{Binding Settings.IsExportTab}" Padding="16,12,16,16"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding SuggestedNameText}" Classes="value" FontWeight="Normal"
                                               Opacity="0.8" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OutputSizeText}" Classes="value" FontWeight="Normal"
                                               Opacity="0.8"/>
                                </Grid>
                                <Button Classes="cta" Height="48" HorizontalAlignment="Stretch"
                                        Command="{Binding SavePngCommand}" Content="{Binding SaveButtonText}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Temporary on-screen perf overlay (see MainViewModel.DebugPerfText) -->
        <Border IsVisible="{Binding ShowDebugPerfOverlay}"
                VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                MaxHeight="320"
                Background="#EE000000" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding DebugPerfText}" Foreground="#7CFC7C" FontFamily="monospace" FontSize="11"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

    </Panel>
</UserControl>
