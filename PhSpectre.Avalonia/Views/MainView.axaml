<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:PhSpectre.Avalonia.Localization"
             xmlns:local="using:PhSpectre.Avalonia.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PhSpectre.Avalonia.ViewModels"
             xmlns:views="using:PhSpectre.Avalonia.Views"
             xmlns:models="using:PhSpectre.Avalonia.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="PhSpectre.Avalonia.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- DataContext for the IDE previewer only; set at runtime in App.axaml.cs. -->
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- Phone (< 840 dp): top bar, stage, filmstrip, bottom sheet. Tablet: the inspector is a permanent column. -->
    <Panel x:Name="RootPanel" Background="{DynamicResource BackgroundBrush}">

        <Grid RowDefinitions="Auto,*">

            <!-- Top bar -->
            <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto,*">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                                IsVisible="{Binding IsWide}">
                        <Image Source="/Assets/PhSpectre.ico" Width="26" Height="26"/>
                        <TextBlock Text="PhSpectre" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Tablet: modes live in the top bar -->
                    <ListBox Grid.Column="1" Classes="seg touch" Width="420" VerticalAlignment="Center"
                             IsVisible="{Binding IsWide}" SelectedIndex="{Binding Settings.TopModeSelection}">
                        <ListBoxItem Content="{l:T 'mode::Edit'}"/>
                        <ListBoxItem Content="{l:T 'Collage'}"/>
                        <ListBoxItem Content="{l:T 'Camera'}" IsVisible="{Binding Settings.ShowCameraMode}"/>
                    </ListBox>

                    <!-- Phone: modes share the top bar, leaving the height to the photo -->
                    <ListBox Grid.ColumnSpan="3" Classes="seg touch" Margin="0,0,100,0" VerticalAlignment="Center"
                             IsVisible="{Binding IsPhone}" SelectedIndex="{Binding Settings.TopModeSelection}">
                        <ListBoxItem Content="{l:T 'mode::Edit'}"/>
                        <ListBoxItem Content="{l:T 'Collage'}"/>
                        <ListBoxItem Content="{l:T 'Camera'}" IsVisible="{Binding Settings.ShowCameraMode}"/>
                    </ListBox>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Panel IsVisible="{Binding IsWide}" VerticalAlignment="Center"><views:CameraIndicator DataContext="{Binding Settings}"/></Panel>
                        <Button Classes="icon-toolbar" Width="40" Height="40" ToolTip.Tip="{l:T 'Appearance'}">
                            <materialIcons:MaterialIcon Kind="ThemeLightDark" Width="20" Height="20"/>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Width="230" Spacing="2" DataContext="{Binding Settings}"
                                                x:DataType="vm:SettingsViewModel">
                                        <TextBlock Text="{l:T 'APPEARANCE'}" Classes="section-title first" Margin="4,4,0,6"/>
                                        <RadioButton Content="{l:T 'System'}" GroupName="appearance" MinHeight="44"
                                                     IsChecked="{Binding IsAppearanceSystem, Mode=OneWay}"
                                                     Command="{Binding SetAppearanceCommand}"
                                                     CommandParameter="{x:Static vm:AppAppearance.System}"/>
                                        <RadioButton Content="{l:T 'theme::Light'}" GroupName="appearance" MinHeight="44"
                                                     IsChecked="{Binding IsAppearanceLight, Mode=OneWay}"
                                                     Command="{Binding SetAppearanceCommand}"
                                                     CommandParameter="{x:Static vm:AppAppearance.Light}"/>
                                        <RadioButton Content="{l:T 'theme::Dark'}" GroupName="appearance" MinHeight="44"
                                                     IsChecked="{Binding IsAppearanceDark, Mode=OneWay}"
                                                     Command="{Binding SetAppearanceCommand}"
                                                     CommandParameter="{x:Static vm:AppAppearance.Dark}"/>
                                        <TextBlock Classes="hint" Margin="4,6,4,4"
                                                   Text="{l:T 'Applies to the app. The exported card has its own theme in Style → Card.'}"/>
                                        <TextBlock Text="{l:T 'LANGUAGE'}" Classes="section-title first" Margin="4,10,4,6"/>
                                        <ComboBox ItemsSource="{Binding LanguageLabels}" SelectedIndex="{Binding LanguageIndex}"
                                                  HorizontalAlignment="Stretch" MinHeight="44" Margin="4,0"
                                                  AutomationProperties.Name="{l:T 'LANGUAGE'}"/>
                                        <TextBlock Classes="hint" Margin="4,4" TextWrapping="Wrap"
                                                   Text="{l:T 'Restart the app to change the language.'}"/>
                                        <StackPanel IsVisible="{Binding IsMobile}" Spacing="6" Margin="4,10,4,4">
                                            <TextBlock Text="{l:T 'WORKING QUALITY'}" Classes="section-title first"/>
                                            <local:SegmentedControl Labels="{l:T 'Fast|Balanced|Best'}" SelectedIndex="{Binding WorkingQualityIndex}"/>
                                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                                       Text="{l:T 'Fast 2000 px · Balanced 3400 px · Best 4800 px. Previews are built from a downscaled copy; saved photos stay full size.'}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <local:IconButton Width="40" Height="40" Command="{Binding PickMainPhotoCommand}"
                                ToolTip.Tip="{l:T 'Pick a photo'}" Icon="FolderOutline" IconSize="20"/>
                        <local:ActionButton Classes="cta" Padding="18,0" Height="40" IsVisible="{Binding ShowTabletExport}"
                                Command="{Binding OpenExportCommand}" Icon="TrayArrowDown" IconSize="18" Text="{l:T 'Export'}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding !Settings.IsCameraMode}">

                <!-- Tool rail -->
                <Panel Grid.Column="0" IsVisible="{Binding IsWide}">
                    <views:EditToolRail DataContext="{Binding Settings.Process}" IsVisible="{Binding Settings.IsEditMode}"/>
                </Panel>

                <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto,Auto">

                    <!-- Collage tray: order is packing order, the first photo supplies the EXIF -->
                    <Border Grid.Row="0" IsVisible="{Binding IsCollageMode}" Padding="16,6,16,4">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding PhotosHeaderText}" Classes="section-title first" Margin="0"/>
                                <TextBlock Grid.Column="1" Text="{l:T 'Use ‹ › to reorder'}" Classes="hint"/>
                            </Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ItemsControl x:Name="CollageTrayItems" ItemsSource="{Binding CollageItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:FileEntry">
                                                <Border Width="64" Height="64" CornerRadius="10" ClipToBounds="True"
                                                        Background="{DynamicResource SurfaceBrush}">
                                                    <Panel>
                                                        <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill"/>
                                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                                                                Background="#CC000000" CornerRadius="3" Padding="4,1"
                                                                IsVisible="{Binding IsCollageExifSource}">
                                                            <TextBlock Text="EXIF" FontSize="9" Foreground="White"/>
                                                        </Border>
                                                        <Button Classes="tray-overlay" Width="24" Height="24" Padding="0"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3"
                                                                Command="{Binding #CollageTrayItems.((vm:MainViewModel)DataContext).RemoveFromCollageCommand}"
                                                                CommandParameter="{Binding}">
                                                            <materialIcons:MaterialIcon Kind="Close" Width="13" Height="13" Foreground="White"/>
                                                        </Button>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                    Margin="3" Spacing="2">
                                                            <Button Classes="tray-overlay" Width="24" Height="24" Padding="0"
                                                                    Command="{Binding #CollageTrayItems.((vm:MainViewModel)DataContext).MoveCollageItemUpCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <materialIcons:MaterialIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="White"/>
                                                            </Button>
                                                            <Button Classes="tray-overlay" Width="24" Height="24" Padding="0"
                                                                    Command="{Binding #CollageTrayItems.((vm:MainViewModel)DataContext).MoveCollageItemDownCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <materialIcons:MaterialIcon Kind="ChevronRight" Width="14" Height="14" Foreground="White"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Panel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Width="64" Height="64" Padding="0" Background="Transparent"
                                            Command="{Binding AddPhotosToCollageCommand}" ToolTip.Tip="{l:T 'Add photos'}"
                                            BorderThickness="1" BorderBrush="{DynamicResource FieldBorderBrush}" CornerRadius="10">
                                        <materialIcons:MaterialIcon Kind="Plus" Width="24" Height="24"
                                                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Stage -->
                    <views:EditCanvas Grid.Row="1" MinHeight="150" DataContext="{Binding Settings.Process}"
                                      IsVisible="{Binding Settings.IsProcessMode}"/>
                    <Panel Grid.Row="1" Background="{DynamicResource StageBrush}" ClipToBounds="True" MinHeight="200"
                           IsVisible="{Binding Settings.ShowCardBody}">

                        <Panel Margin="{Binding CardStageMargin}">
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                    BoxShadow="0 14 36 0 #66000000" CornerRadius="2">
                                <Image Source="{Binding DisplayedResultBitmap}" Stretch="Uniform"
                                       Opacity="{Binding ResultPreviewOpacity}"/>
                            </Border>
                        </Panel>

                        <!-- Empty state -->
                        <Button IsVisible="{Binding ShowPlaceholder}" Command="{Binding PickForEmptyStateCommand}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" BorderThickness="0">
                            <StackPanel Spacing="12" HorizontalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="ImageOutline" Width="40" Height="40"
                                                             Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding EmptyStageText}" FontSize="15" TextAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <StackPanel IsVisible="{Binding ShowGeneratingIndicator}" Spacing="10" Width="180"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Height="3"/>
                            <TextBlock Text="{l:T 'Generating…'}" Classes="hint" TextAlignment="Center"/>
                        </StackPanel>

                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Spacing="10" Margin="12,12,12,0">
                        <views:ErrorCard IsVisible="{Binding HasError}" Message="{Binding ErrorMessage}"
                                         TryAgainCommand="{Binding RetryRenderCommand}"
                                         DismissCommand="{Binding DismissErrorCommand}"/>
                        <!-- Recipe mode without a recipe in the photo -->
                        <Border Classes="pill" IsVisible="{Binding Settings.ShowNoRecipeHint}" Padding="14,10"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <TextBlock Classes="hint" VerticalAlignment="Center" Text="{l:T 'No film recipe found'}"/>
                                <Button Classes="link" Content="{l:T 'Set manually'}" VerticalAlignment="Center"
                                        Command="{Binding Settings.SetRecipeManuallyCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                        <!-- Pill -->
                        <Border Classes="pill" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Padding="10,6"
                                IsVisible="{Binding ShowPill}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                            IsVisible="{Binding ShowUpdatingPill}">
                                    <ProgressBar IsIndeterminate="True" Width="36" Height="3"/>
                                    <TextBlock Text="{l:T 'Updating…'}" FontSize="12" Foreground="{DynamicResource WarningBrush}"/>
                                </StackPanel>
                                <local:CompareSwitch Width="170" IsVisible="{Binding CanCompare}" SelectedIndex="{Binding CompareIndex}"/>
                            <local:ActionButton Classes="cta" Height="30" Padding="14,0" FontSize="12" IsVisible="{Binding ShowRegenerate}"
                                    Command="{Binding RegenerateCommand}" Icon="Refresh" IconSize="14" Text="{Binding RegenerateButtonLabel}"/>
                            </StackPanel>
                        </Border>

                        <!-- Saved toast -->
                        <Border Classes="toast" IsVisible="{Binding IsSaved}" Padding="12,10"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,60">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource SuccessBrush}">
                                    <materialIcons:MaterialIcon Kind="Check" Width="16" Height="16"
                                                                 Foreground="{DynamicResource AccentInkBrush}"/>
                                </Border>
                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OutputSizeText, StringFormat={l:T 'Saved · {0}'}}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{l:T 'Photos · PhSpectre'}" Classes="value" FontWeight="Normal" FontSize="11" Opacity="0.7"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Panel>

                    <!-- Filmstrip (single-photo modes): this session's photos -->
                    <Border Grid.Row="2" IsVisible="{Binding ShowFilmstrip}" Background="{DynamicResource FilmstripBrush}"
                            Padding="12,4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ItemsControl ItemsSource="{Binding RecentPhotos}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:FileEntry">
                                            <Button Classes="film" Classes.current="{Binding IsCurrent}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectRecentPhotoCommand}"
                                                    CommandParameter="{Binding}">
                                                <Border Width="72" Height="52" CornerRadius="6" ClipToBounds="True"
                                                        Background="{DynamicResource SurfaceBrush}">
                                                    <Panel>
                                                        <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill"/>
                                                        <Border Width="18" Height="18" CornerRadius="9" Margin="3"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Background="{DynamicResource SuccessBrush}"
                                                                IsVisible="{Binding IsExported}">
                                                            <materialIcons:MaterialIcon Kind="Check" Width="12" Height="12"
                                                                                         Foreground="{DynamicResource AccentInkBrush}"/>
                                                        </Border>
                                                    </Panel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Classes="film" Command="{Binding PickPhotoCommand}" ToolTip.Tip="{l:T 'Add a photo'}">
                                    <Border Width="72" Height="52" CornerRadius="6" BorderThickness="1"
                                            BorderBrush="{DynamicResource FieldBorderBrush}">
                                        <materialIcons:MaterialIcon Kind="Plus" Width="20" Height="20"
                                                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Phone: Adjust / Export -->
                    <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="12,6,12,8"
                          IsVisible="{Binding ShowPhoneActions}">
                        <Button Grid.Column="0" Classes="primary" Height="44" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding OpenAdjustCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="TuneVariant" Width="18" Height="18"/>
                                <TextBlock Text="{l:T 'Adjust'}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="cta" Height="44" HorizontalAlignment="Stretch"
                                Command="{Binding OpenExportCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="TrayArrowDown" Width="18" Height="18"/>
                                <TextBlock Text="{l:T 'Export'}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Phone bottom sheet -->
                    <Border x:Name="SheetBorder" Grid.Row="4" IsVisible="{Binding ShowSheet}" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0"
                            CornerRadius="20,20,0,0" Height="430">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,8,8,0">
                                <Border Grid.ColumnSpan="2" Width="40" Height="4" CornerRadius="2" HorizontalAlignment="Center"
                                        VerticalAlignment="Top" Margin="0,2,0,0" Background="{DynamicResource CardBorderBrush}"/>
                                <Button Grid.Column="1" Classes="icon-toolbar" Width="36" Height="36"
                                        Command="{Binding CloseSheetCommand}" ToolTip.Tip="{l:T 'Close'}">
                                    <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18"/>
                                </Button>
                            </Grid>
                            <views:EditInspector Rail="False" Grid.Row="1" DataContext="{Binding Settings.Process}" IsVisible="{Binding Settings.IsEditMode}"/>
                            <views:SettingsPanel Grid.Row="1" DataContext="{Binding Settings}" Margin="16,4,10,0" IsVisible="{Binding ShowLegacyInspector}"/>
                            <Border Grid.Row="2" IsVisible="{Binding Settings.ShowLegacyExport}" Padding="16,10,16,14"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding SuggestedNameText}" Classes="value" FontWeight="Normal"
                                                   Opacity="0.8" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding OutputSizeText}" Classes="value" FontWeight="Normal"
                                                   Opacity="0.8"/>
                                    </Grid>
                                    <Button Classes="cta" Height="48" HorizontalAlignment="Stretch"
                                            Command="{Binding SavePngCommand}" Content="{Binding SaveButtonText}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Tablet: permanent inspector -->
                <Border Grid.Column="2" Width="344" IsVisible="{Binding IsWide}" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0">
                    <Panel>
                    <views:EditInspector DataContext="{Binding Settings.Process}" IsVisible="{Binding Settings.IsEditMode}"/>
                    <Grid RowDefinitions="*,Auto" IsVisible="{Binding Settings.ShowLegacyInspector}">
                        <views:SettingsPanel Grid.Row="0" DataContext="{Binding Settings}" Margin="16,14,10,0"/>
                        <Border Grid.Row="1" IsVisible="{Binding Settings.IsExportTab}" Padding="16,12,16,16"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding SuggestedNameText}" Classes="value" FontWeight="Normal"
                                               Opacity="0.8" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OutputSizeText}" Classes="value" FontWeight="Normal"
                                               Opacity="0.8"/>
                                </Grid>
                                <Button Classes="cta" Height="48" HorizontalAlignment="Stretch"
                                        Command="{Binding SavePngCommand}" Content="{Binding SaveButtonText}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    </Panel>
                </Border>
            </Grid>
            <views:CameraModeView Grid.Row="1" DataContext="{Binding Settings}" IsVisible="{Binding IsCameraMode}"/>
        </Grid>


        <!-- Camera dialogs (setup, write) -->
        <views:CameraOverlay DataContext="{Binding Settings}"/>

        <!-- Performance overlay (MainViewModel.DebugPerfText) -->
        <Border IsVisible="{Binding ShowDebugPerfOverlay}"
                VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                MaxHeight="320"
                Background="#EE000000" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding DebugPerfText}" Foreground="#7CFC7C" FontFamily="monospace" FontSize="11"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

    </Panel>
</UserControl>
