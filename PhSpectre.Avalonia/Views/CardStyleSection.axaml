<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:PhSpectre.Avalonia.Localization"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:PhSpectre.Avalonia.ViewModels"
             xmlns:local="using:PhSpectre.Avalonia.Views"
             x:Class="PhSpectre.Avalonia.Views.CardStyleSection"
             x:DataType="vm:SettingsViewModel">
    <UserControl.Styles>
        <StyleInclude Source="/Styles/CardInspector.axaml"/>
    </UserControl.Styles>
        <StackPanel Margin="0,0,0,28">

            <TextBlock Text="{l:T 'CARD'}" Classes="section-title first"/>

            <ListBox Classes="chips" SelectedIndex="{Binding CardChoiceIndex}">
                <ListBoxItem>
                    <StackPanel Spacing="6">
                        <Border Height="48" CornerRadius="8" Background="#111113"
                                BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1"/>
                        <TextBlock Text="{l:T 'theme::Dark'}" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Spacing="6">
                        <Border Height="48" CornerRadius="8" Background="#F3F3F3"
                                BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1"/>
                        <TextBlock Text="{l:T 'theme::Light'}" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Spacing="6">
                        <Border Height="48" CornerRadius="8" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,100%" EndPoint="100%,0%">
                                    <GradientStop Offset="0" Color="#3A3F2A"/>
                                    <GradientStop Offset="1" Color="#B9D2F2"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="+" FontSize="18" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{l:T 'Custom'}" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <!-- Shown for Custom only -->
            <StackPanel IsVisible="{Binding IsCustomBackgroundMode}" Spacing="6" Margin="0,12,0,0">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="36" Height="36" CornerRadius="8" Margin="0,0,8,0"
                            Background="{Binding CustomSwatchBrush}"
                            BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1"/>
                    <TextBox Grid.Column="1" Text="{Binding CustomBackgroundHex, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="#RRGGBB" Classes.invalid="{Binding ShowCustomHexError}"
                             FontFamily="avares://PhSpectre.Avalonia/Assets/Fonts/JetBrainsMono[wght].ttf#JetBrains Mono"/>
                </Grid>
                <TextBlock Text="{l:T 'Not a valid color. Use #RRGGBB. The preview keeps the last valid color.'}"
                           IsVisible="{Binding ShowCustomHexError}" Classes="hint error"/>
            </StackPanel>

            <!-- Hidden for collages -->
            <StackPanel IsVisible="{Binding !ShowCollageSectionUI}">
                <Grid Classes="row" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                    <TextBlock Text="{l:T 'Blurred photo backdrop'}" Classes="row"/>
                    <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding UseBlurredBackdrop}"
                                  IsEnabled="{Binding IsBlurredBackdropEnabled}"/>
                </Grid>
                <TextBlock Text="{l:T 'Not available with a custom color — the backdrop is a flat fill.'}"
                           IsVisible="{Binding IsCustomBackgroundMode}" Classes="hint"/>
            </StackPanel>

            <Grid Classes="row" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                <TextBlock Text="{l:T 'Guide lines'}" Classes="row-dim"/>
                <ComboBox Grid.Column="1" SelectedIndex="{Binding CompositionGuideIndex}">
                    <ComboBoxItem Content="{l:T 'Off'}"/>
                    <ComboBoxItem Content="{l:T 'Thirds'}"/>
                    <ComboBoxItem Content="{l:T 'Golden'}"/>
                    <ComboBoxItem Content="{l:T 'Diagonal'}"/>
                    <ComboBoxItem Content="{l:T 'Cross'}"/>
                </ComboBox>
            </Grid>

            <!-- PALETTE -->
            <StackPanel IsVisible="{Binding IsPaletteSwitchVisible}">
                <TextBlock Text="{l:T 'PALETTE'}" Classes="section-title"/>
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{l:T 'Show palette'}" Classes="row"/>
                    <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding ShowPalette}"/>
                </Grid>
                <StackPanel IsVisible="{Binding ComputeColors}">
                    <Grid Classes="row" ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                        <TextBlock Text="{l:T 'Colors'}" Classes="row-dim" Margin="0,0,16,0"/>
                        <ListBox Grid.Column="1" Classes="seg compact" SelectedIndex="{Binding ColorCountSegment}">
                            <ListBoxItem Content="{l:T 'Auto'}"/>
                            <ListBoxItem Content="3"/>
                            <ListBoxItem Content="4"/>
                            <ListBoxItem Content="5"/>
                            <ListBoxItem Content="6"/>
                            <ListBoxItem Content="8"/>
                        </ListBox>
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Text="{l:T 'Sampling'}" Classes="row-dim"/>
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding SamplingModeIndex}">
                            <ComboBoxItem Content="{l:T 'Vivid'}"/>
                            <ComboBoxItem Content="{l:T 'Standard'}"/>
                            <ComboBoxItem Content="{l:T 'Contrast'}"/>
                        </ComboBox>
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Text="{l:T 'Sort'}" Classes="row-dim"/>
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding SortOrderIndex}">
                            <ComboBoxItem Content="{l:T 'Original order'}"/>
                            <ComboBoxItem Content="{l:T 'By hue'}"/>
                            <ComboBoxItem Content="{l:T 'By luminance'}"/>
                            <ComboBoxItem Content="{l:T 'By share'}"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
                <TextBlock Text="{l:T 'Off keeps the photo and camera plate only (the old “Info only”).'}"
                           IsVisible="{Binding !ShowPalette}" Classes="hint"/>
            </StackPanel>

            <!-- COLLAGE -->
            <StackPanel IsVisible="{Binding ShowCollageSectionUI}">
                <TextBlock Text="{l:T 'COLLAGE'}" Classes="section-title"/>
                <Grid Classes="row" ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="{l:T 'Gutter'}" Classes="row-dim" Margin="0,0,16,0"/>
                    <Slider Grid.Column="1" Classes="v2" local:SliderTapToSeek.Default="8" Value="{Binding GutterThickness}"
                            Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock Grid.Column="2" Text="{Binding GutterThickness, StringFormat={}{0} px}"
                               Classes="value" Margin="12,0,0,0" MinWidth="48" TextAlignment="Right"/>
                </Grid>
            </StackPanel>

            <!-- SWATCHES -->
            <StackPanel IsVisible="{Binding ShowSwatchesSectionUI}">
                <TextBlock Text="{l:T 'SWATCHES'}" Classes="section-title"/>
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{l:T 'Hex labels'}" Classes="row"/>
                    <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding ShowHex}"/>
                </Grid>
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{l:T 'Labels below'}" Classes="row"/>
                    <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding HexBelow}"
                                  IsEnabled="{Binding ShowHex}"/>
                </Grid>
                <TextBlock Text="{l:T 'Turn on Hex labels to choose where they go.'}"
                           IsVisible="{Binding !ShowHex}" Classes="hint"/>
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{l:T 'Percentage'}" Classes="row"/>
                    <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding ShowPercent}"/>
                </Grid>
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{l:T 'Shape'}" Classes="row-dim"/>
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding SwatchShapeIndex}">
                        <ComboBoxItem Content="{l:T 'Rectangle'}"/>
                        <ComboBoxItem Content="{l:T 'Rounded'}"/>
                        <ComboBoxItem Content="{l:T 'Circle'}"/>
                    </ComboBox>
                </Grid>
                <Grid Classes="row" ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="{l:T 'Size'}" Classes="row-dim" Margin="0,0,16,0" MinWidth="64"/>
                    <Slider Grid.Column="1" Classes="v2" local:SliderTapToSeek.Default="2" Value="{Binding SwatchScaleIndex}"
                            Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock Grid.Column="2" Text="{Binding SwatchScaleLabel}" Classes="value"
                               Margin="12,0,0,0" MinWidth="48" TextAlignment="Right"/>
                </Grid>
                <Grid Classes="row" ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="{l:T 'Label size'}" Classes="row-dim" Margin="0,0,16,0" MinWidth="64"/>
                    <Slider Grid.Column="1" Classes="v2" local:SliderTapToSeek.Default="2" Value="{Binding LabelScaleIndex}"
                            Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock Grid.Column="2" Text="{Binding LabelScaleLabel}" Classes="value"
                               Margin="12,0,0,0" MinWidth="48" TextAlignment="Right"/>
                </Grid>
            </StackPanel>

            <!-- Recipe mode has no swatches: its text size lives here instead. -->
            <StackPanel IsVisible="{Binding ShowRecipeCard}">
                <StackPanel IsVisible="{Binding IsRecipeMode}">
                    <TextBlock Text="{l:T 'TEXT'}" Classes="section-title"/>
                    <Grid Classes="row" ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="{l:T 'Text size'}" Classes="row-dim" Margin="0,0,16,0" MinWidth="64"/>
                        <Slider Grid.Column="1" Classes="v2" local:SliderTapToSeek.Default="2" Value="{Binding LabelScaleIndex}"
                                Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="2" Text="{Binding LabelScaleLabel}" Classes="value"
                                   Margin="12,0,0,0" MinWidth="48" TextAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </StackPanel>
</UserControl>
