<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhSpectre.Avalonia.ViewModels"
        xmlns:models="using:PhSpectre.Avalonia.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d"
        x:Class="PhSpectre.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1100" Height="700"
        Title="PhSpectre"
        Icon="/Assets/PhSpectre.ico">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">

        <!-- Toolbar -->
        <Border BorderBrush="{StaticResource ToolbarBackgroundBrush}"
                BorderThickness="0,0,0,1"
                Padding="2">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="8,6">
                <Button Grid.Column="0" Command="{Binding OpenFolderCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="FolderOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Open Folder" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1"
                           Text="{Binding FileInfoText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="12,0"
                           Opacity="0.65"
                           FontSize="12"/>
                <Button Grid.Column="2" Click="OnSettingsClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="CogOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" ColumnDefinitions="220,5,*">

            <!-- Left panel: toggle + file lists + status -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">

                <!-- View toggle with bottom separator -->
                <Border Grid.Row="0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="4,4,4,4">
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="2">
                        <ToggleButton IsChecked="{Binding IsListView}"
                                      ToolTip.Tip="List view"
                                      Padding="8,4"
                                      Margin="4">
                            <materialIcons:MaterialIcon Kind="ViewListOutline" Width="24" Height="24"/>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding IsGridView}"
                                      ToolTip.Tip="Grid view"
                                      Padding="8,4"
                                      Margin="4">
                            <materialIcons:MaterialIcon Kind="ViewGridOutline" Width="24" Height="24"/>
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <!-- File list — list view -->
                <ListBox Grid.Row="1"
                         IsVisible="{Binding IsListView}"
                         ItemsSource="{Binding Files}"
                         SelectedItem="{Binding SelectedFile}"
                         Margin="4,0,4,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:FileEntry">
                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- File list — thumbnail view -->
                <ListBox Grid.Row="1"
                         IsVisible="{Binding IsGridView}"
                         ItemsSource="{Binding Files}"
                         SelectedItem="{Binding SelectedFile}"
                         Margin="4,0,4,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:FileEntry">
                            <Border Width="96" Height="80" Margin="2" Background="{StaticResource SurfaceBrush}" CornerRadius="3">
                                <Panel>
                                    <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill"/>
                                    <TextBlock Text="…"
                                               IsVisible="{Binding ThumbnailBitmap, Converter={x:Static ObjectConverters.IsNull}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Panel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Status bar -->
                <Border Grid.Row="2" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="6,4">
                    <TextBlock Text="{Binding FilePositionText}"
                               FontSize="11"
                               Opacity="0.55"/>
                </Border>

            </Grid>

            <!-- Resizable splitter with grip -->
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="5">
                <GridSplitter.Template>
                    <ControlTemplate>
                        <Border Background="Transparent" Cursor="SizeWestEast">
                            <Border Width="1" Background="{StaticResource CardBorderBrush}" HorizontalAlignment="Center">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                                    <Ellipse Width="3" Height="3" Fill="{StaticResource TextMutedBrush}"/>
                                    <Ellipse Width="3" Height="3" Fill="{StaticResource TextMutedBrush}"/>
                                    <Ellipse Width="3" Height="3" Fill="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- Preview panel -->
            <Grid Grid.Column="2" RowDefinitions="*,Auto" Margin="0,0,4,4">

                <!-- Dual preview: 40% original / 60% result -->
                <Grid Grid.Row="0" ColumnDefinitions="2*,3*">

                    <Border Grid.Column="0" Margin="4" Background="{StaticResource SurfaceBrush}" CornerRadius="4">
                        <Panel>
                            <Image Source="{Binding OriginalBitmap}" Stretch="Uniform"/>
                            <StackPanel IsVisible="{Binding OriginalBitmap, Converter={x:Static ObjectConverters.IsNull}}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <materialIcons:MaterialIcon Kind="ImageOffOutline" Width="28" Height="28"
                                                             HorizontalAlignment="Center"
                                                             Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="No photo selected" Classes="mono-data-small"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Panel>
                    </Border>

                    <Grid Grid.Column="1" Margin="4">
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4">
                            <Image Source="{Binding PaletteBitmap}" Stretch="Uniform"/>
                        </Border>
                        <StackPanel IsVisible="{Binding ShowResultPlaceholder}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <materialIcons:MaterialIcon Kind="ImageOffOutline" Width="28" Height="28"
                                                         HorizontalAlignment="Center"
                                                         Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="No result yet" Classes="mono-data-small"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Generating…"
                                   IsVisible="{Binding IsGenerating}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource ErrorBrush}" Margin="8"/>
                    </Grid>
                </Grid>

                <!-- Save bar: size estimate + save button -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="4,6,0,0">
                    <TextBlock Grid.Column="0"
                               Text="{Binding OutputSizeText}"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Opacity="0.5"/>
                    <Button Grid.Column="1"
                            Command="{Binding SavePngAsync2Command}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Save PNG" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>

</Window>
