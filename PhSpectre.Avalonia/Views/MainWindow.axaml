<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhSpectre.Avalonia.ViewModels"
        xmlns:models="using:PhSpectre.Avalonia.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:views="using:PhSpectre.Avalonia.Views"
        mc:Ignorable="d"
        x:Class="PhSpectre.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1440" Height="900"
        MinWidth="980" MinHeight="620"
        Title=""
        Icon="/Assets/PhSpectre.ico"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="{DynamicResource BackgroundBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!--
        V2 desktop layout (png/V2-Main): top bar with the three modes · stage with the card in the
        middle and the Live / Result | Original / Fit pill under it · filmstrip along the bottom ·
        inspector (Style / Content / Export) on the right.
    -->
    <Grid RowDefinitions="Auto,*">

        <!-- ═══════════ Top bar ═══════════ -->
        <Border x:Name="TopBar" Grid.Row="0" Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto,*">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Image Source="/Assets/PhSpectre.ico" Width="26" Height="26"/>
                        <TextBlock Text="PhSpectre" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <Border Width="1" Height="20" Background="{DynamicResource CardBorderBrush}"/>
                    <Button Classes="link" Command="{Binding OpenFolderCommand}" Foreground="{DynamicResource TextSecondaryBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="FolderOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Open" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Modes -->
                <ListBox x:Name="TopModeBox" Grid.Column="1" Classes="seg" Width="420" VerticalAlignment="Center"
                         SelectedIndex="{Binding Settings.TopModeSelection}">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="ImageOutline" Width="16" Height="16"/>
                            <TextBlock Text="Card"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="FilmstripBoxMultiple" Width="16" Height="16"/>
                            <TextBlock Text="Recipe"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="ViewGridOutline" Width="16" Height="16"/>
                            <TextBlock Text="Collage"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem IsVisible="{Binding Settings.ShowCameraMode}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="CameraOutline" Width="16" Height="16"/>
                            <TextBlock Text="Camera"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Right" VerticalAlignment="Center">

                    <!-- Update banner: unobtrusive, dismissal persists per version. -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                                IsVisible="{Binding IsUpdateAvailable}">
                        <Button Classes="link" Command="{Binding OpenUpdateUrlCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="ArrowUpBoldCircleOutline" Width="14" Height="14"/>
                                <TextBlock Text="{Binding UpdateBannerText}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="icon-toolbar" Width="24" Height="24" Command="{Binding DismissUpdateCommand}"
                                ToolTip.Tip="Dismiss">
                            <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12"/>
                        </Button>
                    </StackPanel>

                    <views:CameraIndicator DataContext="{Binding Settings}" VerticalAlignment="Center"/>

                    <!-- Appearance popover (V2-Light) -->
                    <Button Classes="icon-toolbar" Width="36" Height="36" ToolTip.Tip="Appearance">
                        <materialIcons:MaterialIcon Kind="ThemeLightDark" Width="18" Height="18"/>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="220" Spacing="2" DataContext="{Binding Settings}"
                                            x:DataType="vm:SettingsViewModel">
                                    <TextBlock Text="APPEARANCE" Classes="section-title first" Margin="4,4,0,6"/>
                                    <RadioButton Content="System" GroupName="appearance" IsChecked="{Binding IsAppearanceSystem, Mode=OneWay}"
                                                 Command="{Binding SetAppearanceCommand}"
                                                 CommandParameter="{x:Static vm:AppAppearance.System}"/>
                                    <RadioButton Content="Light" GroupName="appearance" IsChecked="{Binding IsAppearanceLight, Mode=OneWay}"
                                                 Command="{Binding SetAppearanceCommand}"
                                                 CommandParameter="{x:Static vm:AppAppearance.Light}"/>
                                    <RadioButton Content="Dark" GroupName="appearance" IsChecked="{Binding IsAppearanceDark, Mode=OneWay}"
                                                 Command="{Binding SetAppearanceCommand}"
                                                 CommandParameter="{x:Static vm:AppAppearance.Dark}"/>
                                    <TextBlock Classes="hint" Margin="4,6,4,4"
                                               Text="Applies to the app. The exported card has its own theme in Style → Card."/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Export ▾ -->
                    <Button Classes="cta" Padding="16,0" Height="36" MinWidth="110" IsVisible="{Binding !Settings.IsCameraMode}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="TrayArrowDown" Width="16" Height="16"/>
                            <TextBlock Text="Export" VerticalAlignment="Center"/>
                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="14" Height="14"/>
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="{Binding Settings.SaveButtonLabel}"
                                          Command="{Binding SavePngAsync2Command}" InputGesture="Ctrl+S"/>
                                <MenuItem Header="{Binding IdleButtonText}" IsVisible="{Binding ShowSaveAllButton}"
                                          Command="{Binding SaveAllCommand}"/>
                                <Separator/>
                                <MenuItem Header="Export settings…" Command="{Binding Settings.ShowExportTabCommand}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ Body ═══════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,344" IsVisible="{Binding !Settings.IsCameraMode}">

            <!-- Stage + filmstrip -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">

                <!-- Collage tray: order = packing order; the first photo supplies the EXIF. -->
                <Border Grid.Row="0" IsVisible="{Binding IsCollageMode}" Padding="16,12,16,8"
                        Background="{DynamicResource FilmstripBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding CollageItems.Count, StringFormat='{}{0} in collage'}" Classes="section-title first" Margin="0"/>
                            <TextBlock Grid.Column="1" Text="Tick photos in the strip below to add them · use ‹ › to reorder"
                                       Classes="hint"/>
                        </Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="CollageTrayItems" ItemsSource="{Binding CollageItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:FileEntry">
                                        <Border Width="84" Height="64" CornerRadius="8" ClipToBounds="True"
                                                Background="{DynamicResource SurfaceBrush}">
                                            <Panel>
                                                <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill"/>
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4"
                                                        Background="#CC000000" CornerRadius="3" Padding="4,1"
                                                        IsVisible="{Binding IsCollageExifSource}">
                                                    <TextBlock Text="EXIF" FontSize="9" Foreground="White"/>
                                                </Border>
                                                <Button Classes="tray-overlay" Width="20" Height="20"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3"
                                                        ToolTip.Tip="Remove from collage"
                                                        Command="{Binding #CollageTrayItems.((vm:MainWindowViewModel)DataContext).RemoveFromCollageCommand}"
                                                        CommandParameter="{Binding}">
                                                    <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12"/>
                                                </Button>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                            Margin="3" Spacing="2">
                                                    <Button Classes="tray-overlay" Width="20" Height="20" ToolTip.Tip="Move earlier"
                                                            Command="{Binding #CollageTrayItems.((vm:MainWindowViewModel)DataContext).MoveCollageItemUpCommand}"
                                                            CommandParameter="{Binding}">
                                                        <materialIcons:MaterialIcon Kind="ChevronLeft" Width="12" Height="12"/>
                                                    </Button>
                                                    <Button Classes="tray-overlay" Width="20" Height="20" ToolTip.Tip="Move later"
                                                            Command="{Binding #CollageTrayItems.((vm:MainWindowViewModel)DataContext).MoveCollageItemDownCommand}"
                                                            CommandParameter="{Binding}">
                                                        <materialIcons:MaterialIcon Kind="ChevronRight" Width="12" Height="12"/>
                                                    </Button>
                                                </StackPanel>
                                            </Panel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Stage -->
                <Panel Grid.Row="1" Background="{DynamicResource StageBrush}" ClipToBounds="True">

                    <!-- Single photo -->
                    <Panel IsVisible="{Binding !IsCollageMode}" Margin="32,28,32,84">
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                BoxShadow="0 18 48 0 #66000000" CornerRadius="2">
                            <Image Source="{Binding DisplayedSingleBitmap}" Stretch="Uniform"
                                   Opacity="{Binding SinglePreviewOpacity}"/>
                        </Border>
                    </Panel>

                    <!-- Collage -->
                    <Panel IsVisible="{Binding IsCollageMode}" Margin="32,28,32,84">
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                BoxShadow="0 18 48 0 #66000000" CornerRadius="2">
                            <Image Source="{Binding DisplayedCollageBitmap}" Stretch="Uniform"
                                   Opacity="{Binding SinglePreviewOpacity}"/>
                        </Border>
                    </Panel>

                    <!-- Empty state -->
                    <StackPanel IsVisible="{Binding ShowResultPlaceholder}" Spacing="12"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="ImageMultipleOutline" Width="40" Height="40"
                                                     Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding EmptyStageText}" Classes="hint" TextAlignment="Center"/>
                        <Button Classes="cta" Padding="18,0" HorizontalAlignment="Center"
                                IsVisible="{Binding !HasPhotos}" Command="{Binding OpenFolderCommand}"
                                Content="Open folder"/>
                    </StackPanel>

                    <!-- First render only (later renders keep the previous result + the pill) -->
                    <StackPanel IsVisible="{Binding ShowGeneratingTextSingle}" Spacing="10" Width="180"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Height="3"/>
                        <TextBlock Text="Generating…" Classes="hint" TextAlignment="Center"/>
                    </StackPanel>
                    <!-- Banners at the top of the stage: the last result stays visible underneath -->
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Spacing="10" Margin="16,16,16,0">
                        <views:ErrorCard IsVisible="{Binding HasError}" Message="{Binding ErrorMessage}"
                                         TryAgainCommand="{Binding RetryRenderCommand}"
                                         DismissCommand="{Binding DismissErrorCommand}"/>
                        <!-- Recipe mode without a recipe in the photo -->
                        <Border Classes="pill" IsVisible="{Binding Settings.ShowNoRecipeHint}" Padding="14,10"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <TextBlock Classes="hint" VerticalAlignment="Center" TextWrapping="NoWrap"
                                           Text="No film recipe found"/>
                                <Button Classes="link" Content="Set manually" VerticalAlignment="Center"
                                        Command="{Binding Settings.SetRecipeManuallyCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Floating pill: Updating… while rebuilding, Result | Original when comparable -->
                    <Border Classes="pill" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                            Padding="10,6" IsVisible="{Binding ShowPill}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                        IsVisible="{Binding ShowUpdatingPill}">
                                <ProgressBar IsIndeterminate="True" Width="40" Height="3"/>
                                <TextBlock Text="Updating…" FontSize="12" Foreground="{DynamicResource WarningBrush}"/>
                            </StackPanel>
                            <ListBox Classes="seg" Width="190" IsVisible="{Binding CanCompare}"
                                     SelectedIndex="{Binding CompareIndex}">
                                <ListBoxItem Content="Result"/>
                                <ListBoxItem Content="Original"/>
                            </ListBox>
                            <Button Classes="cta" Height="30" Padding="14,0" FontSize="12" IsVisible="{Binding ShowRegenerate}"
                                    Command="{Binding RegenerateCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="14" Height="14"/>
                                    <TextBlock Text="{Binding RegenerateButtonLabel}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Save toast -->
                    <Border Classes="toast" IsVisible="{Binding IsToastVisible}" Padding="14,12" MaxWidth="560" MinWidth="380"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,76">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource SuccessBrush}"
                                    VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Check" Width="18" Height="18"
                                                             Foreground="{DynamicResource AccentInkBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ToastTitle}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding ToastPathText}" Classes="value" FontWeight="Normal" FontSize="11"
                                           Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="cta" Content="Show" Height="32" Padding="14,0"
                                    Command="{Binding ShowInFolderCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Export all: progress, then the summary -->
                    <Border Classes="toast" IsVisible="{Binding ShowBatchProgress}" Padding="16,14" MinWidth="420" MaxWidth="560"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,76">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding BatchHeadline}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding BatchCurrentFileName}" Classes="value"
                                           FontWeight="Normal" FontSize="11" Opacity="0.7"/>
                            </Grid>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding BatchProgressPercent}" Height="6"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding BatchEtaText}" Classes="hint"/>
                                <Button Grid.Column="1" Classes="link" Command="{Binding CancelBatchCommand}"
                                        Content="{Binding ActiveButtonText}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Classes="toast" IsVisible="{Binding ShowBatchResult}" Padding="16,12" MinWidth="360"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,76">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <TextBlock Text="{Binding BatchResultText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Button Grid.Column="1" Classes="link" Content="Details" VerticalAlignment="Center"
                                    IsVisible="{Binding BatchHasErrors}" Command="{Binding ShowBatchErrorsCommand}"/>
                        </Grid>
                    </Border>
                </Panel>

                <!-- Filmstrip -->
                <Border Grid.Row="2" Background="{DynamicResource FilmstripBrush}" Padding="16,10,16,12"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding PhotosHeaderText}" Classes="section-title first"
                                   Margin="0,0,0,8"/>
                        <ListBox x:Name="FilmstripBox" Grid.Row="1" Grid.Column="0" Classes="filmstrip" Height="84"
                                     ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     Cursor="Hand">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:FileEntry">
                                        <Border Width="96" Height="62" CornerRadius="7" ClipToBounds="True"
                                                Background="{DynamicResource SurfaceBrush}">
                                            <Panel>
                                                <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill"/>
                                                <Border Width="20" Height="20" CornerRadius="10"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                                        Background="{DynamicResource SuccessBrush}"
                                                        IsVisible="{Binding IsExported}">
                                                    <materialIcons:MaterialIcon Kind="Check" Width="13" Height="13"
                                                                                 Foreground="{DynamicResource AccentInkBrush}"/>
                                                </Border>
                                                <CheckBox HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2"
                                                          MinWidth="0" MinHeight="0" Padding="0"
                                                          IsChecked="{Binding IsChecked}"
                                                          IsVisible="{Binding #FilmstripBox.((vm:MainWindowViewModel)DataContext).IsCollageMode}"/>
                                            </Panel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FileInfoText}" Classes="value"
                                   FontWeight="Normal" Opacity="0.8" VerticalAlignment="Bottom" Margin="16,0,4,4"
                                   MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Inspector -->
            <Border Grid.Column="1" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="*,Auto">
                    <views:SettingsPanel Grid.Row="0" DataContext="{Binding Settings}" Margin="16,14,10,0"/>

                    <!-- Export footer: what will be written, then the two actions -->
                    <Border Grid.Row="1" IsVisible="{Binding Settings.IsExportTab}" Padding="16,12,16,16"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding SuggestedNameText}" Classes="value" FontWeight="Normal"
                                           Opacity="0.8" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding OutputSizeText}" Classes="value" FontWeight="Normal"
                                           Opacity="0.8"/>
                            </Grid>
                            <Button Classes="cta" Height="44" HorizontalAlignment="Stretch"
                                    Command="{Binding SavePngAsync2Command}"
                                    Content="{Binding Settings.SaveButtonLabel}"/>
                            <Button Classes="primary" Height="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    IsVisible="{Binding ShowSaveAllButton}" Command="{Binding SaveAllCommand}"
                                    Content="{Binding IdleButtonText}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Camera mode: replaces the whole body (recipes · recipe · camera) -->
        <views:CameraModeView Grid.Row="1" DataContext="{Binding Settings}" IsVisible="{Binding IsCameraMode}"/>

        <!-- Camera dialogs (setup, write): modal layer -->
        <views:CameraOverlay Grid.RowSpan="2" DataContext="{Binding Settings}"/>
    </Grid>

</Window>
