<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhSpectre.Avalonia.ViewModels"
        xmlns:models="using:PhSpectre.Avalonia.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:views="using:PhSpectre.Avalonia.Views"
        mc:Ignorable="d"
        x:Class="PhSpectre.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1500" Height="1000"
        MinWidth="900" MinHeight="560"
        Title="PhSpectre"
        Icon="/Assets/PhSpectre.ico">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">

        <!-- Toolbar -->
        <Border BorderBrush="{StaticResource ToolbarBackgroundBrush}"
                BorderThickness="0,0,0,1"
                Padding="2">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="8,6">
                <Button Grid.Column="0" Command="{Binding OpenFolderCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="FolderOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Open Folder" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="1"
                           Text="{Binding FileInfoText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="12,0"
                           Opacity="0.65"
                           FontSize="12"/>

                <!-- Kept off on the far right, away from Open Folder, so the two aren't read
                     as a pair of equally-weighted "primary" actions. -->
                <Button Grid.Column="2" Margin="0,0,6,0" Classes="secondary"
                        IsVisible="{Binding IsCollageMode}"
                        Command="{Binding ExitCollageModeCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Exit Collage" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Update banner — not a modal/dialog on purpose, just an unobtrusive
                     toolbar item; dismissing it persists the dismissed version so it
                     doesn't come back until a newer release ships. -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                            IsVisible="{Binding IsUpdateAvailable}">
                    <Button Classes="text" MinWidth="0" MinHeight="0" Padding="8,4"
                            Command="{Binding OpenUpdateUrlCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="ArrowUpBoldCircleOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding UpdateBannerText}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="icon-toolbar" Width="24" Height="24"
                            Command="{Binding DismissUpdateCommand}"
                            ToolTip.Tip="Dismiss">
                        <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" ColumnDefinitions="220,5,*,300">

            <!-- Left panel: toggle + file lists + status -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">

                <!-- View toggle with bottom separator -->
                <Border Grid.Row="0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="4,4,4,4">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="2">
                            <ToggleButton IsChecked="{Binding IsListView}"
                                          ToolTip.Tip="List view"
                                          Padding="8,4"
                                          Margin="4">
                                <materialIcons:MaterialIcon Kind="ViewListOutline" Width="24" Height="24"/>
                            </ToggleButton>
                            <ToggleButton IsChecked="{Binding IsGridView}"
                                          ToolTip.Tip="Grid view"
                                          Padding="8,4"
                                          Margin="4">
                                <materialIcons:MaterialIcon Kind="ViewGridOutline" Width="24" Height="24"/>
                            </ToggleButton>
                        </StackPanel>

                        <!-- Sits above the checkboxes it turns on, rather than next to
                             "Open Folder" in the toolbar, where it read as a second equally-
                             weighted primary action. -->
                        <Button Grid.Column="2" Classes="icon-toolbar" Margin="4"
                                IsVisible="{Binding !IsCollageMode}"
                                Command="{Binding EnterCollageModeCommand}"
                                ToolTip.Tip="Create collage">
                            <materialIcons:MaterialIcon Kind="ViewGridPlusOutline" Width="18" Height="18"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- File list — list view -->
                <ListBox Grid.Row="1" x:Name="FilesListBox"
                         IsVisible="{Binding IsListView}"
                         ItemsSource="{Binding Files}"
                         SelectedItem="{Binding SelectedFile}"
                         Margin="4,0,4,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:FileEntry">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <CheckBox IsChecked="{Binding IsChecked}"
                                          IsVisible="{Binding #FilesListBox.((vm:MainWindowViewModel)DataContext).IsCollageMode}"
                                          MinWidth="0" MinHeight="0" Padding="0" Margin="0"/>
                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- File list — thumbnail view -->
                <ListBox Grid.Row="1" x:Name="FilesGridBox"
                         IsVisible="{Binding IsGridView}"
                         ItemsSource="{Binding Files}"
                         SelectedItem="{Binding SelectedFile}"
                         Margin="4,0,4,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:FileEntry">
                            <Border Width="96" Height="80" Margin="2" Background="{StaticResource SurfaceBrush}" CornerRadius="3">
                                <Panel>
                                    <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill"/>
                                    <TextBlock Text="…"
                                               IsVisible="{Binding ThumbnailBitmap, Converter={x:Static ObjectConverters.IsNull}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <CheckBox HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2"
                                              IsChecked="{Binding IsChecked}"
                                              IsVisible="{Binding #FilesGridBox.((vm:MainWindowViewModel)DataContext).IsCollageMode}"/>
                                </Panel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Status bar -->
                <Border Grid.Row="2" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="6,4">
                    <TextBlock Text="{Binding FilePositionText}"
                               FontSize="11"
                               Opacity="0.55"/>
                </Border>

            </Grid>

            <!-- Resizable splitter with grip -->
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="5">
                <GridSplitter.Template>
                    <ControlTemplate>
                        <Border Background="Transparent" Cursor="SizeWestEast">
                            <Border Width="1" Background="{StaticResource CardBorderBrush}" HorizontalAlignment="Center">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                                    <Ellipse Width="3" Height="3" Fill="{StaticResource TextMutedBrush}"/>
                                    <Ellipse Width="3" Height="3" Fill="{StaticResource TextMutedBrush}"/>
                                    <Ellipse Width="3" Height="3" Fill="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- Preview panel — image only; save lives in the settings sidebar now -->
            <Grid Grid.Column="2" Margin="0,0,4,4" RowDefinitions="Auto,*">

                <!-- Collage tray — the shared "add/reorder/remove" strip; order doubles as
                     both the row-packing order and (for the first item) the EXIF source.
                     Sized generously (110px cells) since it's the primary way to review the
                     tray — a cramped strip made it hard to tell photos apart at a glance. -->
                <Border Grid.Row="0" IsVisible="{Binding IsCollageMode}" Margin="4,4,4,0"
                        Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding CollageItems.Count, StringFormat='Collage tray — {0} photo(s). Check photos on the left to add them.'}"
                                   FontSize="12" Opacity="0.6"/>
                        <ItemsControl x:Name="CollageTrayItems" ItemsSource="{Binding CollageItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:FileEntry">
                                    <Border Width="110" Height="110" Margin="5" CornerRadius="4"
                                            Background="{StaticResource BackgroundBrush}">
                                        <Panel>
                                            <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill"/>

                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                                                    Background="#CC000000" CornerRadius="3" Padding="4,2"
                                                    IsVisible="{Binding IsCollageExifSource}">
                                                <TextBlock Text="EXIF" FontSize="10" Foreground="White"/>
                                            </Border>

                                            <Button Classes="tray-overlay" Width="24" Height="24"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                                    ToolTip.Tip="Remove from collage"
                                                    Command="{Binding #CollageTrayItems.((vm:MainWindowViewModel)DataContext).RemoveFromCollageCommand}"
                                                    CommandParameter="{Binding}">
                                                <materialIcons:MaterialIcon Kind="Close" Width="13" Height="13"/>
                                            </Button>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                        Margin="4" Spacing="3">
                                                <Button Classes="tray-overlay" Width="22" Height="22"
                                                        ToolTip.Tip="Move earlier"
                                                        Command="{Binding #CollageTrayItems.((vm:MainWindowViewModel)DataContext).MoveCollageItemUpCommand}"
                                                        CommandParameter="{Binding}">
                                                    <materialIcons:MaterialIcon Kind="ChevronLeft" Width="13" Height="13"/>
                                                </Button>
                                                <Button Classes="tray-overlay" Width="22" Height="22"
                                                        ToolTip.Tip="Move later"
                                                        Command="{Binding #CollageTrayItems.((vm:MainWindowViewModel)DataContext).MoveCollageItemDownCommand}"
                                                        CommandParameter="{Binding}">
                                                    <materialIcons:MaterialIcon Kind="ChevronRight" Width="13" Height="13"/>
                                                </Button>
                                            </StackPanel>
                                        </Panel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Single mode: dual preview, 40% original / 60% result. -->
                <Grid Grid.Row="1" ColumnDefinitions="2*,3*" IsVisible="{Binding !IsCollageMode}">

                    <Border Grid.Column="0" Margin="4" Background="{StaticResource SurfaceBrush}" CornerRadius="4">
                        <Panel>
                            <Image Source="{Binding OriginalBitmap}" Stretch="Uniform"/>
                            <StackPanel IsVisible="{Binding OriginalBitmap, Converter={x:Static ObjectConverters.IsNull}}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <materialIcons:MaterialIcon Kind="ImageOffOutline" Width="28" Height="28"
                                                             HorizontalAlignment="Center"
                                                             Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding OriginalPanePlaceholderText}" Classes="mono-data-small"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Panel>
                    </Border>

                    <Grid Grid.Column="1" Margin="4">
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4">
                            <Image Source="{Binding PaletteBitmap}" Stretch="Uniform"/>
                        </Border>
                        <StackPanel IsVisible="{Binding ShowResultPlaceholder}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <materialIcons:MaterialIcon Kind="ImageOffOutline" Width="28" Height="28"
                                                         HorizontalAlignment="Center"
                                                         Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="No result yet" Classes="mono-data-small"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Generating…"
                                   IsVisible="{Binding IsGenerating}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource ErrorBrush}" Margin="8"/>
                    </Grid>
                </Grid>

                <!-- Collage mode: no "original" pane (the tray above already shows the
                     sources) — the result takes the full width instead. Shows the real
                     render once Generate/Regenerate has produced one, falling back to the
                     live layout-only preview otherwise (DisplayedCollageBitmap). -->
                <Grid Grid.Row="1" Margin="4" IsVisible="{Binding IsCollageMode}">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4">
                        <Image Source="{Binding DisplayedCollageBitmap}" Stretch="Uniform"/>
                    </Border>
                    <StackPanel IsVisible="{Binding ShowResultPlaceholder}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <materialIcons:MaterialIcon Kind="ImageOffOutline" Width="28" Height="28"
                                                     HorizontalAlignment="Center"
                                                     Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="No result yet" Classes="mono-data-small"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Generating…"
                               IsVisible="{Binding IsGenerating}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource ErrorBrush}" Margin="8"/>
                </Grid>
            </Grid>

            <!-- Settings — permanent sidebar, not a separate window; changes apply live.
                 Save PNG/JPEG closes out the OUTPUT group at the bottom, pinned outside the
                 ScrollViewer so it's always visible even while settings are scrolled. -->
            <Border Grid.Column="3"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1,0,0,0"
                    Background="{StaticResource SurfaceBrush}">
                <Grid RowDefinitions="*,Auto">
                    <ScrollViewer Grid.Row="0"
                                  MinHeight="120"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsEnabled="{Binding !IsBatchActive}">
                        <!-- Padding lives on the scrolled content, not the ScrollViewer itself,
                             so the bottom gap is part of the scrollable extent — otherwise the
                             last row gets clipped flush against the viewport edge even at
                             full scroll. -->
                        <views:SettingsPanel DataContext="{Binding Settings}"
                                              HorizontalAlignment="Stretch"
                                              Margin="16,12,16,24"/>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="16,0,16,16" Spacing="8">
                        <Border Height="1" Background="{StaticResource CardBorderBrush}"/>

                        <!-- Settings/metadata changes never re-render on their own — this
                             button is the only thing that triggers it, so nothing surprising
                             happens while the user is still adjusting things. In collage mode
                             it also stands in for the tray's edits (no live auto-render there,
                             see MainWindowViewModel), so it's highlighted primary/blue instead
                             of the usual muted secondary — there's actually nothing rendered
                             yet, not just a tweak to an existing result. -->
                        <Button Height="34" IsVisible="{Binding IsRegenerateAvailable}"
                                Classes.primary="{Binding IsCollageMode}"
                                Classes.secondary="{Binding !IsCollageMode}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding RegenerateCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding RegenerateButtonLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{Binding OutputSizeText}"
                                   HorizontalAlignment="Center"
                                   FontSize="11" Opacity="0.5"/>
                        <Button Classes="primary" Height="38"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding SavePngAsync2Command}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Settings.SaveButtonLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Batch progress — visible only while Running/Cancelling -->
                        <StackPanel IsVisible="{Binding ShowBatchProgress}" Spacing="4" Margin="0,8,0,0">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding BatchProgressPercent}" Height="6"/>
                            <TextBlock Text="{Binding BatchProgressText}"
                                       HorizontalAlignment="Center" FontSize="11" Opacity="0.7"/>
                            <TextBlock Text="{Binding BatchCurrentFileName}"
                                       HorizontalAlignment="Center" FontSize="11" Opacity="0.5"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Batch result — visible after Finished/Cancelled, until the next action or ~5s -->
                        <StackPanel IsVisible="{Binding ShowBatchResult}" Spacing="4" Margin="0,8,0,0">
                            <TextBlock Text="{Binding BatchResultText}"
                                       HorizontalAlignment="Center" FontSize="11" Opacity="0.85"
                                       TextWrapping="Wrap"/>
                            <Button Classes="text" Content="Details" FontSize="12" MinWidth="0" MinHeight="0" Padding="0"
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding BatchHasErrors}"
                                    Command="{Binding ShowBatchErrorsCommand}"/>
                        </StackPanel>

                        <!-- Save all / Cancel — mutually exclusive, same slot, ≥12px below Save PNG -->
                        <Button Classes="secondary" Height="36" Margin="0,12,0,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                IsVisible="{Binding ShowSaveAllButton}"
                                Command="{Binding SaveAllCommand}"
                                Content="{Binding IdleButtonText}"/>
                        <Button Classes="danger-outline" Height="36" Margin="0,12,0,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                IsVisible="{Binding IsBatchActive}"
                                Command="{Binding CancelBatchCommand}"
                                Content="{Binding ActiveButtonText}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</Window>
