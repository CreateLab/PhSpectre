<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:PhSpectre.Avalonia.Localization"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:PhSpectre.Avalonia.ViewModels"
             xmlns:local="using:PhSpectre.Avalonia.Views"
             x:Class="PhSpectre.Avalonia.Views.RecipeEditorView"
             x:DataType="vm:SettingsViewModel">

    <!-- Manual recipe form (DataContext = Settings): replaces the inspector, or a dialog in the Camera mode. -->
        <Grid x:Name="RecipeEditor" RowDefinitions="Auto,*,Auto"
              Background="{DynamicResource PanelBrush}">
            <Grid.Styles>
                <Style Selector="Grid#RecipeEditor StackPanel.cell">
                    <Setter Property="Spacing" Value="4"/>
                    <Setter Property="Margin" Value="6,0,6,12"/>
                </Style>
                <Style Selector="Grid#RecipeEditor TextBox, Grid#RecipeEditor ComboBox">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                    <Setter Property="CornerRadius" Value="6"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Height" Value="{Binding FieldHeight}"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="Padding" Value="12,0"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                </Style>
                <Style Selector="Grid#RecipeEditor ComboBox">
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
                <Style Selector="Grid#RecipeEditor TextBlock.group">
                    <Setter Property="Margin" Value="0,14,0,10"/>
                </Style>
            </Grid.Styles>

            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                <Button Classes="link" Width="40" Height="40" Command="{Binding CancelRecipeEditorCommand}"
                        Foreground="{DynamicResource TextPrimaryBrush}" ToolTip.Tip="{l:T 'Back (Esc)'}">
                    <materialIcons:MaterialIcon Kind="ArrowLeft" Width="20" Height="20"/>
                </Button>
                <TextBlock Grid.Column="1" Text="{l:T 'Edit recipe'}" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="4,0,0,0"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button Grid.Column="2" Classes="link" Content="{l:T 'Save'}" Padding="12,0" Height="40"
                        Command="{Binding SaveRecipeEditsCommand}"/>
            </Grid>

            <!-- Body: the only part that scrolls -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,12,0">
                <StackPanel Margin="0,0,0,16">
                    <StackPanel Classes="cell" Margin="0,0,0,4">
                        <TextBlock Text="{l:T 'Recipe name'}" Classes="hint"/>
                        <TextBox Text="{Binding EditRecipeName}" PlaceholderText="{l:T 'e.g. Kodak Portra 400'}"/>
                    </StackPanel>
                    <StackPanel Classes="cell" Margin="0,0,0,4">
                        <TextBlock Text="{l:T 'Film simulation'}" Classes="hint"/>
                        <ComboBox ItemsSource="{Binding FilmSimulationOptions}" SelectedItem="{Binding EditFilmSimulation}"
                                  PlaceholderText="{l:T 'Not set'}"/>
                    </StackPanel>

                    <TextBlock Text="{l:T 'TONE'}" Classes="section-title group"/>
                    <UniformGrid x:Name="EditGroup1" Columns="1" Margin="-6,0">
                        <StackPanel Classes="cell">
                            <TextBlock Text="{l:T 'White balance'}" Classes="hint"/>
                            <ComboBox ItemsSource="{Binding WhiteBalanceOptions}" SelectedItem="{Binding EditWhiteBalance}"/>
                        </StackPanel>
                        <StackPanel Classes="cell">
                            <TextBlock Text="{l:T 'Dynamic range'}" Classes="hint"/>
                            <ComboBox ItemsSource="{Binding DynamicRangeOptions}" SelectedItem="{Binding EditDynamicRange}"/>
                        </StackPanel>
                        <StackPanel Classes="cell">
                            <TextBlock Text="{l:T 'WB shift (Red)'}" Classes="hint"/>
                            <local:NumberStepper Value="{Binding EditWhiteBalanceShiftRed}" Minimum="-9" Maximum="9" Step="1" ControlHeight="{Binding FieldHeight}"/>
                        </StackPanel>
                        <StackPanel Classes="cell">
                            <TextBlock Text="{l:T 'WB shift (Blue)'}" Classes="hint"/>
                            <local:NumberStepper Value="{Binding EditWhiteBalanceShiftBlue}" Minimum="-9" Maximum="9" Step="1" ControlHeight="{Binding FieldHeight}"/>
                        </StackPanel>
                        <StackPanel Classes="cell">
                            <TextBlock Text="{l:T 'Highlight tone'}" Classes="hint"/>
                            <local:NumberStepper Value="{Binding EditHighlightTone}" Minimum="-2" Maximum="4" Step="0.5" ControlHeight="{Binding FieldHeight}"/>
                        </StackPanel>
                        <StackPanel Classes="cell">
                            <TextBlock Text="{l:T 'Shadow tone'}" Classes="hint"/>
                            <local:NumberStepper Value="{Binding EditShadowTone}" Minimum="-2" Maximum="4" Step="0.5" ControlHeight="{Binding FieldHeight}"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="{l:T 'COLOR &amp; SHARPNESS'}" Classes="section-title group"/>
                    <UniformGrid x:Name="EditGroup2" Columns="1" Margin="-6,0">
                        <StackPanel Classes="cell">
                            <TextBlock Text="{l:T 'Color'}" Classes="hint"/>
                            <local:NumberStepper Value="{Binding EditColor}" Minimum="-4" Maximum="4" Step="1" ControlHeight="{Binding FieldHeight}"/>
                        </StackPanel>
                        <StackPanel Classes="cell">
                            <TextBlock Text="{l:T 'Sharpness'}" Classes="hint"/>
                            <local:NumberStepper Value="{Binding EditSharpness}" Minimum="-4" Maximum="4" Step="1" ControlHeight="{Binding FieldHeight}"/>
                        </StackPanel>
                        <StackPanel Classes="cell">
                            <TextBlock Text="{l:T 'Noise reduction'}" Classes="hint"/>
                            <local:NumberStepper Value="{Binding EditNoiseReduction}" Minimum="-4" Maximum="4" Step="1" ControlHeight="{Binding FieldHeight}"/>
                        </StackPanel>
                        <StackPanel Classes="cell">
                            <TextBlock Text="{l:T 'Clarity'}" Classes="hint"/>
                            <local:NumberStepper Value="{Binding EditClarity}" Minimum="-5" Maximum="5" Step="0.5" ControlHeight="{Binding FieldHeight}"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="{l:T 'EFFECTS'}" Classes="section-title group"/>
                    <UniformGrid x:Name="EditGroup3" Columns="1" Margin="-6,0">
                        <StackPanel Classes="cell">
                            <TextBlock Text="{l:T 'Grain effect'}" Classes="hint"/>
                            <ComboBox ItemsSource="{Binding ThreeLevelOptions}" SelectedItem="{Binding EditGrainEffect}"/>
                        </StackPanel>
                        <StackPanel Classes="cell">
                            <TextBlock Text="{l:T 'Color Chrome'}" Classes="hint"/>
                            <ComboBox ItemsSource="{Binding ThreeLevelOptions}" SelectedItem="{Binding EditColorChromeEffect}"/>
                        </StackPanel>
                        <StackPanel Classes="cell">
                            <TextBlock Text="{l:T 'Color Chrome Blue'}" Classes="hint"/>
                            <ComboBox ItemsSource="{Binding ThreeLevelOptions}" SelectedItem="{Binding EditColorChromeFxBlue}"/>
                        </StackPanel>
                        <StackPanel Classes="cell">
                            <TextBlock Text="{l:T 'B&amp;W adjustment'}" Classes="hint"/>
                            <local:NumberStepper Value="{Binding EditBwAdjustment}" Minimum="-9" Maximum="9" Step="1" ControlHeight="{Binding FieldHeight}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <StackPanel Spacing="8">
                    <Border IsVisible="{Binding ShowDiscardConfirm}" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="{l:T 'Discard unsaved changes?'}" Classes="row" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Classes="link" Content="{l:T 'Keep editing'}" Margin="8,0"
                                    Command="{Binding KeepEditingRecipeCommand}"/>
                            <Button Grid.Column="2" Classes="link" Content="{l:T 'Discard'}" Foreground="{DynamicResource ErrorBrush}"
                                    Command="{Binding CancelRecipeEditorCommand}"/>
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Classes="ghost" Content="{l:T 'Cancel'}" Height="44" HorizontalAlignment="Stretch"
                                Command="{Binding CancelRecipeEditorCommand}"/>
                        <Button Grid.Column="1" Classes="cta" Content="{l:T 'Save'}" Height="44" HorizontalAlignment="Stretch"
                                Command="{Binding SaveRecipeEditsCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
</UserControl>
