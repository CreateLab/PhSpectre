<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PhSpectre.Avalonia.Views.NumberStepper">
    <!-- Themed numeric field: big − / + buttons around a plain input; out-of-range or unparsable
         input is highlighted with the range instead of being clamped silently. -->
    <StackPanel Spacing="4">
        <Grid ColumnDefinitions="Auto,*,Auto" x:Name="Row">
            <Button Grid.Column="0" x:Name="MinusButton" Classes="ghost" Padding="0" CornerRadius="6"
                    Content="−" FontSize="16" Click="Minus_Click"/>
            <TextBox Grid.Column="1" x:Name="Input" Margin="6,0" CornerRadius="6" FontSize="13"
                     TextAlignment="Center" VerticalContentAlignment="Center" Padding="8,0"
                     TextChanged="Input_TextChanged" LostFocus="Input_LostFocus" KeyDown="Input_KeyDown"/>
            <Button Grid.Column="2" x:Name="PlusButton" Classes="ghost" Padding="0" CornerRadius="6"
                    Content="+" FontSize="16" Click="Plus_Click"/>
        </Grid>
        <TextBlock x:Name="ErrorText" Classes="hint error" IsVisible="False"/>
    </StackPanel>
</UserControl>
