 <rdf:Description rdf:about="" crs:Name="Clean Skin" crs:Treatment="Color" crs:SkinSmoothing="55" crs:Sharpness="30" crs:Contrast2012="4" crs:Shadows2012="10" crs:HueAdjustmentRed="12" crs:SaturationAdjustmentRed="-8" crs:LuminanceAdjustmentRed="6" crs:HueAdjustmentOrange="0" crs:SaturationAdjustmentOrange="-5" crs:LuminanceAdjustmentOrange="10" crs:HueAdjustmentYellow="-14" crs:SaturationAdjustmentYellow="-18" crs:LuminanceAdjustmentYellow="4" crs:ColorGradeShadowHue="205" crs:ColorGradeShadowSat="5">
